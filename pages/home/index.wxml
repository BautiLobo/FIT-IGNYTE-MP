<view class="container">

  <!-- Topbar -->
  <view class="topbar">
    <view class="profile-btn" bindtap="goToProfile">
      <text class="profile-icon">P</text>
    </view>
    <image class="topbar-logo" src="/images/mark.png" mode="aspectFit" />
    <view style="width:64rpx;"></view>
  </view>

  <scroll-view class="scroll" scroll-y>
   <view class="scroll-inner">

    <block wx:if="{{loading}}">
      <view class="loading-wrap"><view class="spinner"></view></view>
    </block>

    <block wx:else>

      <view wx:for="{{notifications}}" wx:key="id" class="notif-banner">
        <view class="notif-banner-body">
          <text class="notif-banner-title">{{item.title}}</text>
          <text class="notif-banner-message">{{item.message}}</text>
        </view>
        <text class="notif-banner-close" bindtap="dismissNotification" data-id="{{item.id}}">✕</text>
      </view>

      <!-- Saludo + estado -->
      <view class="greeting-row">
        <view class="greeting-info">
          <text class="greeting-name">{{lbl_hi}}</text>
          <text class="greeting-plan">{{planLabel}}</text>
        </view>
        <view class="status-badge {{isUpcoming ? 'status-badge-upcoming' : ''}}">
          <view class="status-dot"></view>
          <text class="status-text">{{isUpcoming ? lbl_upcoming : lbl_active}}</text>
        </view>
      </view>

      <view class="banner banner-amber" wx:if="{{isUpcoming}}">
        <text class="banner-title">{{lbl_plan_starts_soon}}</text>
        <text class="banner-sub">{{lbl_first_delivery}}</text>
      </view>

      <view class="renewal-card" wx:if="{{showRenewal}}" hover-class="card-hover" bindtap="goToRenewal">
        <view class="renewal-body">
          <text class="renewal-title">{{lbl_renewal_title}}</text>
          <text class="renewal-sub">{{lbl_renewal_sub}}</text>
        </view>
        <view class="renewal-btn">
          <text class="renewal-btn-text">{{lbl_renewal_btn}}</text>
        </view>
      </view>

      <view class="banner banner-green" wx:if="{{hasPendingRenewal && !isUpcoming}}">
        <text class="banner-title">{{lbl_renewal_pending_title}}</text>
        <text class="banner-sub">{{lbl_renewal_pending_sub}}</text>
      </view>

      <!-- Próxima entrega -->
      <view class="next-card" wx:if="{{nextDelivery}}">
        <view class="next-head">
          <text class="next-kicker">{{lbl_next_delivery}}</text>
          <view class="next-when"><text>{{nextDelivery.when}}{{nextDelivery.time ? ' · ' + nextDelivery.time : ''}}</text></view>
        </view>
        <view wx:for="{{nextDelivery.meals}}" wx:key="key" class="next-meal">
          <image wx:if="{{item.photo}}" class="next-thumb" src="{{item.photo}}" mode="aspectFill" />
          <view wx:else class="next-thumb next-thumb-ph"></view>
          <view class="next-info">
            <text class="next-name">{{item.name}}</text>
            <view class="macros">
              <text class="macro macro-kcal">{{item.kcal}} {{lbl_kcal}}</text>
              <text class="macro macro-p">{{lbl_protein}} {{item.protein}}g</text>
              <text class="macro macro-c">{{lbl_carbs}} {{item.carbs}}g</text>
              <text class="macro macro-f">{{lbl_fat}} {{item.fat}}g</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Comidas de la semana -->
      <view class="meals-card">
        <view class="meals-card-header">
          <text class="meals-card-label">{{lbl_this_weeks_meals}}</text>
          <view class="meals-card-edit" bindtap="goToMealSelect">
            <text>{{lbl_edit}}</text>
          </view>
        </view>

        <view wx:for="{{weekMeals}}" wx:key="key" class="week-row {{index === weekMeals.length - 1 ? 'week-row-last' : ''}} {{item.isToday ? 'week-row-today' : ''}}">
          <text class="week-day {{item.isToday ? 'week-day-today' : ''}}">{{item.dayShort}}</text>
          <view class="week-meal-names">
            <view wx:for="{{item.mealNames}}" wx:for-item="mealName" wx:key="key" class="week-meal-row">
              <text class="week-meal-name">{{mealName.name}}</text>
            </view>
          </view>
          <text class="week-time {{item.isToday ? 'week-time-today' : ''}}">{{item.time}}</text>
        </view>
      </view>

      <view class="btn-wrap">
        <view class="menu-btn" hover-class="menu-btn-hover" bindtap="viewMenu">
          <view class="menu-btn-icon"><view class="doc"><view class="doc-line"></view><view class="doc-line"></view><view class="doc-line doc-line-short"></view></view></view>
          <view class="sbtn-body"><text class="sbtn-title">{{lbl_view_menu}}</text></view>
          <text class="sbtn-arrow menu-btn-arrow">›</text>
        </view>
        <view class="contact-link-row btn-mt">
          <text class="contact-link-q">{{lbl_any_doubt}}</text>
          <button class="contact-link" hover-class="contact-link-hover" open-type="contact">{{lbl_contact}}</button>
        </view>
      </view>

    </block>

   </view>
  </scroll-view>

</view>

<view class="container">

  <!-- Topbar -->
  <view class="topbar" style="height: 180rpx; display: flex; box-sizing: border-box">
    <view class="profile-btn" bindtap="goToProfile" style="position: relative; left: 0rpx; top: 8rpx">
      <text class="profile-icon">P</text>
    </view>
    <image style="width: 56rpx; height: 75rpx; display: block; box-sizing: border-box" class="topbar-logo" src="/images/mark.png" mode="aspectFit" />
    <view style="width:60rpx;"></view>
  </view>

  <scroll-view class="scroll" scroll-y style="position: relative; left: 0rpx; top: 0rpx">

    <block wx:if="{{loading}}">
      <view class="loading-wrap" style="position: relative; left: 0rpx; top: -175rpx"><view class="spinner"></view></view>
    </block>

    <block wx:else>

      <view wx:for="{{notifications}}" wx:key="id" class="notif-banner">
        <view class="notif-banner-icon">🔔</view>
        <view class="notif-banner-body">
          <text class="notif-banner-title">{{item.title}}</text>
          <text class="notif-banner-message">{{item.message}}</text>
        </view>
        <text class="notif-banner-close" bindtap="dismissNotification" data-id="{{item.id}}">✕</text>
      </view>

      <view class="greeting-row">
        <view>
          <text class="greeting-name">{{lbl_hi}}</text>
          <text class="greeting-sub plan-color">{{planLabel}}</text>
        </view>
        <view class="status-badge {{isUpcoming ? 'status-badge-upcoming' : ''}}">
          <text class="status-check" wx:if="{{!isUpcoming}}">✓</text>
          <text class="status-text">{{isUpcoming ? lbl_upcoming : lbl_active}}</text>
        </view>
      </view>

      <view class="delivery-banner delivery-banner-upcoming" wx:if="{{isUpcoming}}">
        <view class="delivery-banner-body">
          <text class="delivery-banner-title">{{lbl_plan_starts_soon}}</text>
          <text class="delivery-banner-sub">{{lbl_first_delivery}}</text>
        </view>
      </view>

      <view class="renewal-card" wx:if="{{showRenewal}}" bindtap="goToRenewal">
        <view class="renewal-body">
          <text class="renewal-title">{{lbl_renewal_title}}</text>
          <text class="renewal-sub">{{lbl_renewal_sub}}</text>
        </view>
        <view class="renewal-btn">
          <text class="renewal-btn-text">{{lbl_renewal_btn}}</text>
        </view>
      </view>

      <view class="delivery-banner" wx:if="{{hasPendingRenewal}}">
        <view class="delivery-banner-body">
          <text class="delivery-banner-title">{{lbl_renewal_pending_title}}</text>
          <text class="delivery-banner-sub">{{lbl_renewal_pending_sub}}</text>
        </view>
      </view>

      <view class="meals-card">
        <view class="meals-card-header">
          <text class="meals-card-label">{{lbl_this_weeks_meals}}</text>
          <view class="meals-card-view" bindtap="goToMealSelect">
            <text class="meals-card-view-text">{{lbl_edit}}</text>
          </view>
        </view>

        <view wx:for="{{weekMeals}}" wx:key="day" class="week-row {{index === weekMeals.length - 1 ? 'week-row-last' : ''}} {{item.isToday ? 'week-row-today' : ''}}">
          <text class="week-day {{item.isToday ? 'week-day-today' : ''}}">{{item.dayShort}}</text>
          <view class="week-meal-names">
            <view wx:for="{{item.mealNames}}" wx:for-item="mealName" wx:key="key" class="week-meal-row">
              <text class="week-meal-name">{{mealName.name}}</text>
            </view>
          </view>
          <text class="week-time {{item.isToday ? 'week-time-today' : ''}}">{{item.time}}</text>
        </view>
      </view>

<view class="btn-wrap">
        <button class="btn-contact" open-type="contact">{{lbl_contact}}</button>
      </view>

    </block>

  </scroll-view>

</view>

<view class="container">

  <view class="topbar">
    <image class="topbar-logo" src="/images/mark.png" mode="aspectFit" />
  </view>

  <view class="content">

    <!-- Hero -->
    <view class="hero">
      <view class="hero-circle">
        <text class="hero-glyph">📍</text>
      </view>
      <text class="hero-title">{{lbl_title}}</text>
      <text class="hero-sub">{{lbl_body}}</text>
    </view>

    <!-- Outside radius info -->
    <view class="info-card">
      <text class="info-icon">⚠</text>
      <text class="info-text">{{lbl_reason}}</text>
    </view>

    <!-- Contact (primary) -->
    <button class="btn-primary" open-type="contact">  {{lbl_contact}}</button>

    <!-- Start over (secondary) -->
    <button class="btn-secondary" bindtap="startOver">  {{lbl_start_over_btn}}</button>

  </view>

</view>

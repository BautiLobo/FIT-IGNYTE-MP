<view class="container">

  <view class="topbar">
    <image class="topbar-logo" src="/images/mark.png" mode="aspectFit" />
  </view>

  <view class="content">

    <view class="hero">
      <view class="status-ring {{rejectType === 'waitlist' ? 'is-wait' : ''}}">
        <text class="status-x" wx:if="{{rejectType !== 'waitlist'}}">✕</text>
        <view class="wait-dots" wx:else><view class="d"></view><view class="d"></view><view class="d"></view></view>
      </view>
      <text class="headline">{{lbl_title}}</text>
      <view class="header-divider"></view>
      <text class="intro">{{lbl_body}}</text>
    </view>

    <!-- Motivo: fuera de zona o lista de espera (mensaje del admin) -->
    <view class="info-card {{rejectType === 'waitlist' ? 'is-wait' : ''}}">
      <text class="info-text">{{lbl_reason}}</text>
    </view>

    <view class="spacer"></view>

    <button class="btn-primary" open-type="contact">{{lbl_contact}}</button>
    <button class="btn-secondary" bindtap="startOver">{{lbl_start_over_btn}}</button>

  </view>

</view>

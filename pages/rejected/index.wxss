/* pages/rejected/index.wxss — mismo lenguaje que tiers / plans / calendario */

page { background:#0b0b0c; }

.container { display:flex; flex-direction:column; height:100vh; background:#0b0b0c; overflow:hidden; }

.topbar { padding:80rpx 32rpx 24rpx; border-bottom:1rpx solid #1a1a22; flex-shrink:0; display:flex; align-items:center; justify-content:center; }
.topbar-logo { width:72rpx; height:72rpx; }

.content {
  flex:1; min-height:0;
  display:flex; flex-direction:column;
  padding:0 32rpx; padding-bottom:calc(40rpx + env(safe-area-inset-bottom));
  box-sizing:border-box;
  background:radial-gradient(ellipse at 50% 25%, rgba(232,52,42,0.10) 0%, transparent 55%);
}

/* ── HERO ── */
.hero { flex-shrink:0; display:flex; flex-direction:column; align-items:center; text-align:center; padding:12vh 0 36rpx; }

.status-ring {
  width:168rpx; height:168rpx; border-radius:50%;
  background:rgba(232,52,42,0.12); border:4rpx solid #e8342a;
  box-shadow:0 0 60rpx rgba(232,52,42,0.3);
  display:flex; align-items:center; justify-content:center;
  margin-bottom:36rpx;
}
.status-x { font-size:72rpx; font-weight:900; color:#e8342a; line-height:1; }

.headline {
  font-size:50rpx; font-weight:900; font-style:italic; letter-spacing:-1.5rpx; text-transform:uppercase;
  color:#f3f3f4; line-height:1.1; display:block;
  text-shadow:0 6rpx 28rpx rgba(232,52,42,0.18);
}
.header-divider { width:56rpx; height:6rpx; background:#e8342a; border-radius:6rpx; margin-top:16rpx; }
.intro { font-size:26rpx; font-weight:500; color:#9a9aa3; line-height:1.5; display:block; margin-top:14rpx; max-width:580rpx; }

/* ── MOTIVO ── */
.info-card {
  flex-shrink:0;
  background:linear-gradient(160deg, rgba(232,52,42,0.16) 0%, #13131a 60%);
  border:2rpx solid rgba(232,52,42,0.45); border-radius:22rpx;
  padding:26rpx 28rpx; text-align:center;
}
.info-text { font-size:27rpx; font-weight:800; color:#f3f3f4; line-height:1.45; }

.spacer { flex:1; min-height:40rpx; }

/* ── BOTONES ── */
button { margin:0 !important; padding:0 !important; background:transparent; border:none; }
.btn-primary {
  background:#e8342a !important; border-radius:24rpx !important;
  height:96rpx; line-height:96rpx; color:#fff !important; font-size:32rpx !important; font-weight:800 !important; letter-spacing:1rpx;
  text-align:center; width:100% !important; box-sizing:border-box; display:block; flex-shrink:0;
  box-shadow:0 8rpx 30rpx rgba(232,52,42,0.35);
  margin-bottom:16rpx !important;
}
.btn-secondary {
  background:#13131a !important; border:2rpx solid #2a2a33 !important; border-radius:24rpx !important;
  height:88rpx; line-height:88rpx; color:#f3f3f4 !important; font-size:28rpx !important; font-weight:700 !important;
  text-align:center; width:100% !important; box-sizing:border-box; display:block; flex-shrink:0;
}
.btn-primary::after, .btn-secondary::after { border:none; }

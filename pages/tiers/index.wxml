<view class="container">

  <view class="topbar">
    <view class="back-btn" bindtap="goBack"><text class="back-arrow">‹</text></view>
    <text class="topbar-title">{{lbl_title}}</text>
    <view style="width:64rpx;"></view>
  </view>

  <view class="body">

    <block wx:if="{{loading}}">
      <view class="loading-wrap"><view class="spinner"></view></view>
    </block>

    <block wx:else>

      <!-- HEADER — mismo patrón que how-it-works -->
      <view class="header-block">
        <view class="kicker-pill"><text class="kicker">{{lbl_kicker}}</text></view>
        <text class="headline">{{lbl_heading}}</text>
        <view class="header-divider"></view>
        <text class="intro">{{lbl_subtitle}}</text>
      </view>

      <!-- TIER CARDS — se reparten el alto disponible, sin scroll -->
      <view class="cards">
        <view
          wx:for="{{tiers}}"
          wx:key="name"
          class="tier-card"
          hover-class="tier-card-hover"
          bindtap="selectTier"
          data-tier="{{item.name}}"
          data-tier-zh="{{item.displayName}}"
          data-tier-color="{{item.color}}"
          style="border-color:{{item.cardBorder}}; background:linear-gradient(160deg, {{item.tintStrong}} 0%, #13131a 58%);">

          <view class="tier-top">
            <text class="tier-name" style="color:{{item.color}};">{{item.displayName}}</text>
            <text class="tier-count" style="color:{{item.color}}; background:{{item.tint}}; border-color:{{item.tintBorder}};">{{item.planCount}} {{lbl_plans_available}}</text>
          </view>

          <view class="tier-stats" wx:if="{{item.kcal}}">
            <text class="stat-val" style="color:{{item.color}};">{{item.kcal}}</text>
            <text class="stat-lbl">{{lbl_kcal}}</text>
            <view class="stat-sep"></view>
            <text class="stat-val" style="color:{{item.color}};">{{item.protein}}</text>
            <text class="stat-lbl">{{lbl_protein}}</text>
          </view>

          <!-- Best for: 3 columnas iguales separadas por líneas finas -->
          <view class="tier-best" wx:if="{{item.bestFor.length}}" style="background:{{item.tint}}; border-color:{{item.tintBorder}};">
            <view wx:for="{{item.bestFor}}" wx:for-item="point" wx:key="*this" class="tier-best-col" style="border-left-color:{{item.tintBorder}};">
              <text class="tier-best-txt">{{point}}</text>
            </view>
          </view>

          <view class="tier-cta" style="background:{{item.color}}; box-shadow:0 8rpx 28rpx {{item.glow}};">
            <text class="tier-cta-txt">{{lbl_see_plans}}</text>
            <text class="tier-cta-arrow">›</text>
          </view>
        </view>
      </view>

      <!-- BOTONES -->
      <view class="bottom-row">
        <button class="btn-contact" open-type="contact"><text>{{lbl_contact_us}}</text></button>
        <button class="btn-pdf" bindtap="openBrochure">{{lbl_menu_pdf}}</button>
      </view>

    </block>

  </view>

</view>

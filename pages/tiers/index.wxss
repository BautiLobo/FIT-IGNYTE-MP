/* pages/tiers/index.wxss — "What's your goal?" (una sola pantalla, sin scroll) */

page { background:#0b0b0c; height:100%; overflow:hidden; }

.container { display:flex; flex-direction:column; height:100vh; background:#0b0b0c; overflow:hidden; }

/* ── TOPBAR — igual que how-it-works ── */
.topbar { background:#0b0b0c; padding:80rpx 32rpx 24rpx; border-bottom:1rpx solid #1a1a22; display:flex; align-items:center; flex-shrink:0; }
.back-btn { width:64rpx; height:64rpx; background:#1a1a22; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.back-arrow { font-size:40rpx; color:#f3f3f4; line-height:1; }
.topbar-title { flex:1; text-align:center; font-size:34rpx; font-weight:800; color:#f3f3f4; }

/* ── BODY: header + tarjetas (flex:1) + botones ── */
.body {
  flex:1;
  min-height:0;
  display:flex;
  flex-direction:column;
  padding:24rpx 32rpx;
  padding-bottom:calc(24rpx + env(safe-area-inset-bottom));
  box-sizing:border-box;
}

.loading-wrap { display:flex; justify-content:center; padding:80rpx 0; }
.spinner { width:48rpx; height:48rpx; border:4rpx solid #2a2a33; border-top-color:#e8342a; border-radius:50%; animation:spin 0.8s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }

/* ── HEADER ── */
.header-block { display:flex; flex-direction:column; align-items:center; margin-bottom:28rpx; flex-shrink:0; }
/* kicker como pastilla, mismo lenguaje que los step-tag de how-it-works */
.kicker-pill {
  background:rgba(232,52,42,0.12);
  border:1rpx solid rgba(232,52,42,0.35);
  border-radius:100rpx;
  padding:8rpx 20rpx;
}
.kicker { font-size:19rpx; color:#e8342a; font-weight:800; letter-spacing:4rpx; text-transform:uppercase; display:block; line-height:1.2; }
.headline {
  font-size:62rpx;
  font-weight:900;
  font-style:italic;
  letter-spacing:-2rpx;
  color:#f3f3f4;
  line-height:1.05;
  display:block;
  text-align:center;
  margin-top:18rpx;
  text-shadow:0 6rpx 28rpx rgba(232,52,42,0.18);
}
.header-divider { width:56rpx; height:6rpx; background:#e8342a; border-radius:6rpx; margin-top:16rpx; }
.intro { font-size:25rpx; font-weight:500; color:#9a9aa3; line-height:1.45; letter-spacing:0.3rpx; display:block; text-align:center; margin-top:14rpx; max-width:540rpx; }

/* ── TIER CARDS ── */
.cards { flex:1; min-height:0; display:flex; flex-direction:column; gap:20rpx; }

.tier-card {
  flex:1;
  min-height:0;
  background:#13131a;
  border:2rpx solid #2a2a33;
  border-radius:24rpx;
  padding:24rpx 26rpx;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  box-sizing:border-box;
  width:100%;
  overflow:hidden;
  transition:transform .12s, opacity .12s;
}
.tier-card-hover { transform:scale(0.985); opacity:0.9; }

.tier-top { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.tier-name {
  font-size:46rpx;
  font-weight:800;
  font-style:italic;
  text-transform:uppercase;
  letter-spacing:-1rpx;
  line-height:1.1;
}

/* kcal / proteína en una línea */
.tier-stats { display:flex; align-items:baseline; flex-wrap:wrap; margin-top:12rpx; }
.stat-val { font-size:38rpx; font-weight:900; color:#f3f3f4; margin-right:8rpx; letter-spacing:-0.5rpx; }
.stat-lbl { font-size:19rpx; font-weight:700; letter-spacing:1rpx; text-transform:uppercase; color:#9a9aa3; }
.stat-sep { width:1rpx; height:26rpx; background:#2a2a33; margin:0 20rpx; align-self:center; }

/* best for — grilla de 3 columnas resaltada con el color del tier (fondo y líneas vienen inline) */
.tier-best {
  display:flex;
  align-items:stretch;
  margin-top:16rpx;
  padding:16rpx 0;
  border:1rpx solid;
  border-radius:16rpx;
}
.tier-best-col {
  flex:1;
  min-width:0;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:0 10rpx;
  border-left:1rpx solid;
}
.tier-best-col:first-child { border-left:none !important; }
.tier-best-txt { font-size:23rpx; font-weight:800; color:#f3f3f4; line-height:1.3; text-align:center; word-break:break-word; }

/* CTA */
.tier-cta {
  flex-shrink:0;
  height:76rpx;
  margin-top:16rpx;
  border-radius:18rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:12rpx;
}
.tier-cta-txt { font-size:26rpx; font-weight:800; letter-spacing:2rpx; text-transform:uppercase; color:#0b0b0c; }
.tier-cta-arrow { font-size:38rpx; font-weight:700; color:#0b0b0c; line-height:1; margin-top:-4rpx; }

/* ── BOTONES ── */
.bottom-row { margin-top:20rpx; flex-shrink:0; }

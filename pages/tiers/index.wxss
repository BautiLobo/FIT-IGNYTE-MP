/* pages/tiers/index.wxss */

.container { display:flex; flex-direction:column; height:100vh; background:#0b0b0c; overflow:hidden; }

/* ── TOPBAR ── */
.topbar { background:#0b0b0c; padding:80rpx 28rpx 20rpx; border-bottom:1rpx solid #1a1a22; display:flex; align-items:center; flex-shrink:0; }
.back-btn { width:60rpx; height:60rpx; background:#1a1a22; border-radius:50%; display:flex; align-items:center; justify-content:center; }
.back-arrow { font-size:36rpx; color:#f3f3f4; font-weight:300; }
.topbar-title { flex:1; text-align:center; font-size:32rpx; font-weight:800; color:#f3f3f4; }

/* ── SCROLL ── */
.scroll { flex:1; padding:24rpx 24rpx; box-sizing:border-box; overflow-x:hidden; }

.loading-wrap { display:flex; justify-content:center; padding:80rpx 0; }
.spinner { width:48rpx; height:48rpx; border:4rpx solid #2a2a33; border-top-color:#e8342a; border-radius:50%; animation:spin 0.8s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }

/* ── HEADER — mismo estilo que how-it-works ── */
.list-header { display:flex; flex-direction:column; align-items:center; gap:10rpx; margin-bottom:32rpx; padding:16rpx 4rpx 0; }
.list-title { font-size:52rpx; font-weight:800; font-style:italic; color:#f3f3f4; line-height:1.2; display:block; text-align:center; }
.list-sub { font-size:26rpx; color:#9a9aa3; line-height:1.45; display:block; text-align:center; max-width:580rpx; }
.header-divider { width:64rpx; height:5rpx; background:#e8342a; border-radius:4rpx; margin-top:10rpx; }

/* ── TIER CARDS — con "Best for" y bullets, estilo tarjeta enriquecida ── */
.tier-wrap { margin-bottom:20rpx; }

.tier-card {
  background: #13131a;
  border: 2rpx solid;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
  width: 100%;
  display: flex;
  flex-direction: column;
}

.tier-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.tier-head-left { display:flex; align-items:center; gap:14rpx; }
.tier-icon { font-size: 40rpx; line-height: 1; }
.tier-name { font-size:38rpx; font-weight:800; color:#f3f3f4; display:block; }
.tier-arrow { font-size:48rpx; font-weight:300; }

.tier-best-for {
  font-size: 26rpx;
  font-weight: 800;
  color: #f3f3f4;
  display: block;
  margin-bottom: 16rpx;
}

.tier-bullets {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.tier-bullet-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.tier-bullet-check {
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 20rpx;
  line-height: 1;
}

.tier-bullet-text { font-size: 26rpx; font-weight: 700; color: #e4e4e7; }

.tier-kcal { font-size:24rpx; font-weight:700; color:#beb6b6; display:block; margin-bottom: 10rpx; }

.tier-sub { font-size:26rpx; color:#beb6b6; display:block; }

/* ── HINT ── */
.hint-wrap { display:flex; align-items:center; gap:16rpx; padding:32rpx 4rpx; }
.hint-line { flex:1; height:1rpx; background:#9f9fa8; display:block; }
.hint { font-size:22rpx; color:#beb6b6; white-space:nowrap; }

/* ── BOTTOM BAR ── */
.bottom-bar { padding:8rpx 0 40rpx; }
button { margin:0 !important; padding:0 !important; background:transparent; border:none; }
.btn-contact {
  background: #13131a !important;
  border: 1rpx solid #1a1a22 !important;
  border-radius: 20rpx !important;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  width: 100% !important;
  box-sizing: border-box;
  display: block;
  margin-bottom: 16rpx;
}
.btn-contact::after { border: none; }
.btn-contact text { font-size: 28rpx; font-weight: 600; color: #beb6b6; }
.btn-pdf {
  background: rgba(167,139,250,0.12) !important;
  border: 2rpx solid #e8342a !important;
  border-radius: 24rpx !important;
  height: 92rpx;
  line-height: 92rpx;
  color: #e8342a !important;
  font-size: 30rpx !important;
  font-weight: 800 !important;
  text-align: center;
  width: 100% !important;
  box-sizing: border-box;
  display: block;
}

/* pages/edit-profile/index.wxss — mismo formulario que register */

page { background:#0b0b0c; }

.container { display:flex; flex-direction:column; height:100vh; background:#0b0b0c; overflow:hidden; box-sizing:border-box; }

/* ── TOPBAR ── */
.topbar { background:#0b0b0c; padding:80rpx 32rpx 24rpx; border-bottom:1rpx solid #1a1a22; flex-shrink:0; display:flex; align-items:center; box-sizing:border-box; width:100%; }
.back-btn { width:64rpx; height:64rpx; background:#1a1a22; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.back-arrow { font-size:40rpx; color:#f3f3f4; line-height:1; font-weight:400; }
.topbar-center { flex:1; text-align:center; }
.topbar-title { font-size:34rpx; font-weight:800; color:#f3f3f4; display:block; }

/* ── SCROLL ── */
.scroll { flex:1; min-height:0; box-sizing:border-box; overflow-x:hidden; width:100%; }
.scroll-inner { padding:28rpx 32rpx; padding-bottom:calc(40rpx + env(safe-area-inset-bottom)); box-sizing:border-box; }

/* ── CAMPOS ── */
.field { margin-bottom:28rpx; width:100%; box-sizing:border-box; }
.field-label { display:block; font-size:20rpx; font-weight:800; letter-spacing:3rpx; text-transform:uppercase; color:#9a9aa3; margin-bottom:12rpx; }
.field-input, .field-textarea {
  background:#13131a; border:2rpx solid #2a2a33; border-radius:18rpx;
  padding:28rpx 26rpx; font-size:29rpx; font-weight:600; color:#f3f3f4;
  width:100%; box-sizing:border-box;
}
.field-input { min-height:92rpx; }
.field-textarea { min-height:92rpx; }
.field-input-warning { border-color:rgba(232,52,42,0.55); background:linear-gradient(160deg, rgba(232,52,42,0.10) 0%, #13131a 60%); }
.field-ph { color:#5d5d65; font-weight:500; }

/* ── BOTONES ── */
.btn-wrap { padding:12rpx 0 24rpx; display:flex; flex-direction:column; gap:16rpx; box-sizing:border-box; width:100%; }
button { margin:0 !important; padding:0 !important; background:transparent; border:none; }
.btn-primary {
  background:#e8342a !important; border-radius:24rpx !important;
  height:96rpx; line-height:96rpx;
  font-size:32rpx !important; font-weight:800 !important; letter-spacing:1rpx; color:#fff !important;
  width:100% !important; text-align:center; box-sizing:border-box; display:block;
  box-shadow:0 8rpx 30rpx rgba(232,52,42,0.35);
}
.btn-disabled { opacity:0.4; box-shadow:none; }
.btn-hint { font-size:22rpx; font-weight:500; color:#9a9aa3; text-align:center; display:block; line-height:1.45; }

/* ── AVISOS DE CAMBIO DE DIRECCIÓN ── */
.pending-banner, .result-banner { border-radius:18rpx; padding:20rpx 24rpx; margin-bottom:28rpx; border:2rpx solid; }
.pending-banner { background:rgba(234,179,8,0.10); border-color:rgba(234,179,8,0.4); }
.pending-banner-text { font-size:24rpx; font-weight:600; color:#eab308; line-height:1.5; }
.result-banner { display:flex; align-items:flex-start; gap:16rpx; }
.result-banner-approved { background:rgba(52,211,153,0.10); border-color:rgba(52,211,153,0.4); }
.result-banner-rejected { background:rgba(232,52,42,0.10); border-color:rgba(232,52,42,0.4); }
.result-banner-text { font-size:24rpx; font-weight:600; line-height:1.5; flex:1; }
.result-banner-approved .result-banner-text { color:#34D399; }
.result-banner-rejected .result-banner-text { color:#f87171; }
.result-banner-close { font-size:24rpx; color:#9a9aa3; flex-shrink:0; padding:0 4rpx; }

/* pages/start-date/index.wxss — calendario de días de entrega (mismo lenguaje que tiers / plans) */

page { background:#0b0b0c; height:100%; overflow:hidden; }

.container { display:flex; flex-direction:column; height:100vh; background:#0b0b0c; overflow:hidden; }

/* ── TOPBAR ── */
.topbar { background:#0b0b0c; padding:80rpx 32rpx 24rpx; border-bottom:1rpx solid #1a1a22; flex-shrink:0; display:flex; align-items:center; }
.back-btn { width:64rpx; height:64rpx; background:#1a1a22; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.back-arrow { font-size:40rpx; color:#f3f3f4; line-height:1; }
.topbar-title { flex:1; text-align:center; font-size:34rpx; font-weight:800; color:#f3f3f4; }

.content {
  flex:1;
  min-height:0;
  display:flex;
  flex-direction:column;
  padding:24rpx 32rpx;
  padding-bottom:calc(24rpx + env(safe-area-inset-bottom));
  box-sizing:border-box;
  overflow:hidden;
}

.center-block { width:100%; display:flex; align-items:center; justify-content:center; flex:1; }
.loading-wrap { display:flex; justify-content:center; padding:80rpx 0; }
.spinner { width:48rpx; height:48rpx; border:4rpx solid #2a2a33; border-top-color:#e8342a; border-radius:50%; animation:spin 0.8s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }

.cal-wrap { flex:1; min-height:0; display:flex; flex-direction:column; }

/* ── HEADER ── */
.header-block { display:flex; flex-direction:column; align-items:center; flex-shrink:0; }
.kicker-pill { background:rgba(232,52,42,0.12); border:1rpx solid rgba(232,52,42,0.35); border-radius:100rpx; padding:8rpx 20rpx; }
.kicker { font-size:19rpx; color:#e8342a; font-weight:800; letter-spacing:4rpx; text-transform:uppercase; display:block; line-height:1.2; }
.headline {
  font-size:48rpx; font-weight:900; font-style:italic; letter-spacing:-1.5rpx;
  color:#f3f3f4; line-height:1.1; display:block; text-align:center; margin-top:16rpx;
  text-shadow:0 6rpx 28rpx rgba(232,52,42,0.18);
}
.header-divider { width:56rpx; height:6rpx; background:#e8342a; border-radius:6rpx; margin-top:14rpx; }
.intro { font-size:25rpx; font-weight:500; color:#9a9aa3; line-height:1.45; display:block; text-align:center; margin-top:12rpx; max-width:560rpx; }

/* ── PROGRESO ── */
.progress { display:flex; flex-direction:column; align-items:center; gap:10rpx; margin:24rpx 0 20rpx; flex-shrink:0; }
.progress-bar { display:flex; gap:8rpx; width:100%; }
.progress-seg { flex:1; height:8rpx; border-radius:8rpx; background:#1a1a22; transition:background .15s; }
.progress-seg-on { background:#e8342a; }
.progress-seg-done { background:#34D399; }
.progress-txt { font-size:22rpx; font-weight:800; letter-spacing:2rpx; text-transform:uppercase; color:#9a9aa3; }
.progress-txt-done { color:#34D399; }

/* ── CALENDARIO ── */
.cal-card {
  flex:0 1 auto;   /* alto según el contenido: sin hueco vacío abajo */
  min-height:0;
  display:flex;
  flex-direction:column;
  background:#13131a;
  border:2rpx solid #2a2a33;
  border-radius:24rpx;
  padding:20rpx 20rpx 8rpx;
}

.weekday-header { display:flex; gap:8rpx; padding-bottom:12rpx; border-bottom:1rpx solid #1a1a22; flex-shrink:0; }
.weekday-cell { flex:1; text-align:center; font-size:20rpx; font-weight:800; letter-spacing:1rpx; text-transform:uppercase; color:#9a9aa3; }
.weekday-cell-weekend { color:#3f3f45; }

.calendar-scroll { flex:0 1 auto; min-height:0; }

.month-row { display:flex; align-items:center; gap:14rpx; margin:18rpx 0 12rpx; }
.month-label { font-size:24rpx; font-weight:900; font-style:italic; letter-spacing:1rpx; text-transform:uppercase; color:#f3f3f4; }
.month-line { flex:1; height:1rpx; background:#2a2a33; }

.week-row { display:flex; gap:8rpx; margin-bottom:8rpx; }

.day-cell {
  flex:1;
  aspect-ratio:1 / 1;
  border-radius:16rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  box-sizing:border-box;
  transition:transform .1s, background .15s;
}
.day-num { font-size:28rpx; font-weight:800; line-height:1; }

.day-cell-available { background:#1a1a22; border:2rpx solid #2a2a33; }
.day-cell-available .day-num { color:#f3f3f4; }

.day-cell-selected { background:#e8342a; border:2rpx solid #e8342a; box-shadow:0 6rpx 20rpx rgba(232,52,42,0.45); }
.day-cell-selected .day-num { color:#fff; font-weight:900; }

.day-cell-unavailable { background:transparent; }

/* empuja el botón al fondo de la pantalla */
.spacer { flex:1; min-height:0; }
.day-cell-unavailable .day-num { color:#3f3f45; font-weight:600; }

.day-cell-hover { transform:scale(0.92); }

/* ── LEYENDA ── */
.legend { display:flex; gap:28rpx; justify-content:center; padding:18rpx 0; flex-shrink:0; }
.legend-item { display:flex; align-items:center; gap:10rpx; }
.legend-item text { font-size:21rpx; font-weight:700; color:#9a9aa3; }
.legend-dot { width:22rpx; height:22rpx; border-radius:6rpx; box-sizing:border-box; }
.legend-dot-selected { background:#e8342a; }
.legend-dot-available { background:#1a1a22; border:2rpx solid #2a2a33; }
.legend-dot-unavailable { background:transparent; border:2rpx dashed #3f3f45; }

/* ── BOTÓN — mismo que how-it-works ── */
button { margin:0 !important; padding:0 !important; background:transparent; border:none; }
.btn-primary {
  background:#e8342a !important;
  border-radius:24rpx !important;
  height:96rpx;
  line-height:96rpx;
  color:#fff !important;
  font-size:32rpx !important;
  font-weight:800 !important;
  letter-spacing:1rpx;
  text-align:center;
  width:100% !important;
  box-sizing:border-box;
  display:block;
  flex-shrink:0;
  box-shadow:0 8rpx 30rpx rgba(232,52,42,0.35);
}
.btn-disabled { opacity:0.35; box-shadow:none; }

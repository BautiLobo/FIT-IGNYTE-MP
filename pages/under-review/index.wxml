<view class="container">

  <view class="topbar">
    <image class="topbar-logo" src="/images/mark.png" mode="aspectFit" />
  </view>

  <scroll-view class="scroll" scroll-y>
   <view class="scroll-inner">

    <!-- Hero: anillo ámbar que late = "esperando" -->
    <view class="hero">
      <view class="status-ring">
        <view class="status-ring-pulse"></view>
        <view class="status-ring-core"></view>
      </view>
      <text class="headline">{{lbl_title}}</text>
      <view class="header-divider"></view>
      <text class="intro">{{lbl_body}}</text>
    </view>

    <!-- Resumen del pedido -->
    <view class="card">
      <view class="summary-row summary-border">
        <text class="summary-key">{{lbl_plan}}</text>
        <text class="summary-val">{{order.plan_name}} · ¥{{order.plan_price}}/wk</text>
      </view>
      <view class="summary-row">
        <text class="summary-key">{{lbl_district}}</text>
        <text class="summary-val">{{order.district}}</text>
      </view>
    </view>

    <!-- Pasos -->
    <view class="card">
      <view class="step-row">
        <view class="step-dot step-dot-done"><text class="step-check">✓</text></view>
        <text class="step-label step-label-done">{{lbl_step1}}</text>
      </view>
      <view class="step-line step-line-done"></view>
      <view class="step-row">
        <view class="step-dot step-dot-active"><view class="step-inner-dot"></view></view>
        <text class="step-label step-label-active">{{lbl_step2}}</text>
      </view>
      <view class="step-line"></view>
      <view class="step-row">
        <view class="step-dot step-dot-idle"></view>
        <text class="step-label step-label-idle">{{lbl_step3}}</text>
      </view>
    </view>

   </view>
  </scroll-view>

  <view class="bottom-bar">
    <button class="btn-outline" open-type="contact">{{lbl_contact}}</button>
    <text class="hint">{{lbl_eta}}</text>
  </view>

</view>

/* pages/under-review/index.wxss — mismo lenguaje que tiers / plans / calendario */

page { background:#0b0b0c; }

.container { display:flex; flex-direction:column; height:100vh; background:#0b0b0c; overflow:hidden; }

/* ── TOPBAR ── */
.topbar { padding:80rpx 32rpx 24rpx; border-bottom:1rpx solid #1a1a22; flex-shrink:0; display:flex; align-items:center; justify-content:center; }
.topbar-logo { width:72rpx; height:72rpx; }

/* ── SCROLL ── */
.scroll { flex:1; min-height:0; box-sizing:border-box; overflow-x:hidden; }
.scroll-inner { padding:0 32rpx 32rpx; box-sizing:border-box; }

/* ── HERO ── */
.hero { display:flex; flex-direction:column; align-items:center; text-align:center; padding:56rpx 8rpx 40rpx; }

.status-ring { position:relative; width:168rpx; height:168rpx; display:flex; align-items:center; justify-content:center; margin-bottom:32rpx; }
.status-ring-pulse { position:absolute; width:168rpx; height:168rpx; border-radius:50%; border:4rpx solid rgba(234,179,8,0.55); animation:ring 1.8s ease-out infinite; }
.status-ring-core { width:112rpx; height:112rpx; border-radius:50%; background:rgba(234,179,8,0.14); border:4rpx solid #eab308; box-shadow:0 0 40rpx rgba(234,179,8,0.3); }
@keyframes ring { 0% { transform:scale(0.7); opacity:0.9; } 100% { transform:scale(1.15); opacity:0; } }

.headline {
  font-size:52rpx; font-weight:900; font-style:italic; letter-spacing:-1.5rpx; text-transform:uppercase;
  color:#f3f3f4; line-height:1.1; display:block;
  text-shadow:0 6rpx 28rpx rgba(232,52,42,0.18);
}
.header-divider { width:56rpx; height:6rpx; background:#e8342a; border-radius:6rpx; margin-top:16rpx; }
.intro { font-size:26rpx; font-weight:500; color:#9a9aa3; line-height:1.5; display:block; margin-top:14rpx; max-width:580rpx; }

/* ── CARD ── */
.card { background:#13131a; border:2rpx solid #2a2a33; border-radius:22rpx; padding:20rpx 26rpx; margin-bottom:16rpx; }

.summary-row { display:flex; justify-content:space-between; align-items:center; gap:16rpx; padding:16rpx 0; }
.summary-border { border-bottom:1rpx solid #1a1a22; }
.summary-key { font-size:20rpx; font-weight:800; letter-spacing:3rpx; text-transform:uppercase; color:#9a9aa3; flex-shrink:0; }
.summary-val { font-size:27rpx; font-weight:700; color:#f3f3f4; text-align:right; }

/* ── PASOS ── */
.step-row { display:flex; align-items:center; gap:22rpx; padding:8rpx 0; }
.step-line { width:4rpx; height:30rpx; background:#2a2a33; border-radius:4rpx; margin-left:20rpx; }
.step-line-done { background:#34D399; }

.step-dot { width:44rpx; height:44rpx; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center; box-sizing:border-box; }
.step-dot-done { background:#34D399; box-shadow:0 4rpx 14rpx rgba(52,211,153,0.35); }
.step-check { font-size:24rpx; color:#0b0b0c; font-weight:900; }
.step-dot-active { border:4rpx solid #eab308; }
.step-inner-dot { width:16rpx; height:16rpx; border-radius:50%; background:#eab308; }
.step-dot-idle { border:2rpx solid #3f3f45; }

.step-label { font-size:28rpx; font-weight:800; }
.step-label-done { color:#34D399; }
.step-label-active { color:#eab308; font-style:italic; text-transform:uppercase; letter-spacing:0.5rpx; }
.step-label-idle { color:#5d5d65; }

/* ── ABAJO ── */
.bottom-bar { padding:20rpx 32rpx; padding-bottom:calc(32rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #1a1a22; background:#0b0b0c; flex-shrink:0; display:flex; flex-direction:column; gap:16rpx; }

button { margin:0 !important; padding:0 !important; background:transparent; border:none; }
.hint { font-size:22rpx; font-weight:500; color:#9a9aa3; text-align:center; display:block; margin-top:16rpx; }

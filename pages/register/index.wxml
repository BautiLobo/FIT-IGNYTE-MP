<view class="container">

  <view class="topbar">
    <view class="back-btn" bindtap="goBack"><text class="back-arrow">‹</text></view>
    <view class="topbar-center">
      <text class="topbar-title">{{lbl_title}}</text>
    </view>
    <view style="width:60rpx;"></view>
  </view>

  <scroll-view class="scroll" scroll-y>
   <view class="scroll-inner">

    <view class="plan-bar" wx:if="{{selectedPlan}}">
      <view class="plan-bar-info">
        <text class="plan-bar-name">{{selectedPlan.displayName}}</text>
        <text class="plan-bar-price">¥{{selectedPlan.price}} / week</text>
      </view>
      <view class="plan-bar-change" bindtap="goBack"><text>{{lbl_change}}</text></view>
    </view>

    <view class="field">
      <text class="field-label">{{lbl_name_label}}</text>
      <input class="field-input" placeholder-class="field-ph" placeholder="{{lbl_name_ph}}" value="{{form.name}}" bindinput="onInput" data-field="name" />
    </view>

    <view class="field">
      <text class="field-label">{{lbl_phone_label}}</text>
      <input class="field-input" placeholder-class="field-ph" placeholder="{{lbl_phone_ph}}" value="{{form.phone}}" bindinput="onInput" data-field="phone" type="text" />
    </view>

    <view class="field">
      <text class="field-label">{{lbl_district_label}}</text>
      <input class="field-input" placeholder-class="field-ph" placeholder="{{lbl_district_ph}}" value="{{form.district}}" bindinput="onInput" data-field="district" />
    </view>

    <view class="field">
      <text class="field-label">{{lbl_address_label}}</text>
      <textarea class="field-textarea" placeholder-class="field-ph" placeholder="{{lbl_address_ph}}" value="{{form.address}}" bindinput="onInput" data-field="address" auto-height />
    </view>

    <view class="field">
      <text class="field-label">{{lbl_access_label}}</text>
      <input class="field-input" placeholder-class="field-ph" placeholder="{{lbl_access_ph}}" value="{{form.access}}" bindinput="onInput" data-field="access" />
    </view>

    <view class="field">
      <text class="field-label">{{lbl_allergies_label}}</text>
      <input class="field-input field-input-warning" placeholder-class="field-ph" placeholder="{{lbl_allergies_ph}}" value="{{form.allergies}}" bindinput="onInput" data-field="allergies" />
    </view>

    <view class="field">
      <text class="field-label">{{lbl_goal_label}}</text>
      <input class="field-input" placeholder-class="field-ph" placeholder="{{lbl_goal_ph}}" value="{{form.goal}}" bindinput="onInput" data-field="goal" />
    </view>

    <!-- Aceptación obligatoria de la política de privacidad (solo alta nueva) -->
    <view class="privacy-consent-row" wx:if="{{!editing}}">
      <view class="privacy-checkbox {{privacyAccepted ? 'privacy-checkbox-checked' : ''}}" bindtap="togglePrivacyAccepted">
        <text wx:if="{{privacyAccepted}}">✓</text>
      </view>
      <text class="privacy-consent-text" bindtap="togglePrivacyAccepted">{{lbl_privacy_agree_pre}}</text>
      <button class="privacy-link-inline" bindtap="viewPrivacyPolicy">
        <text>{{lbl_privacy_agree_link}}</text>
      </button>
    </view>

    <view class="btn-wrap">
      <button class="btn-primary {{submitting ? 'btn-disabled' : ''}}" bindtap="submit" disabled="{{submitting}}">
        {{submitting ? lbl_submitting : (editing ? lbl_save_changes : lbl_next)}}
      </button>
      <text class="btn-hint">{{editing ? lbl_delivery_note : lbl_area_note}}</text>
      <button class="privacy-link" wx:if="{{editing}}" bindtap="viewPrivacyPolicy">
        <text>{{lbl_privacy_policy}}</text>
      </button>
    </view>

   </view>
  </scroll-view>

  <!-- Pop-up oficial de privacidad (WeChat Privacy Protocol Development Guide) -->
  <view class="privacy-modal-mask" wx:if="{{showPrivacyModal}}">
    <view class="privacy-modal-card">
      <text class="privacy-modal-title">{{lbl_privacy_modal_title}}</text>
      <text class="privacy-modal-body">{{lbl_privacy_modal_body}}</text>
      <button class="privacy-modal-view-btn" bindtap="viewPrivacyPolicy">{{lbl_privacy_modal_view}}</button>
      <button class="privacy-modal-agree-btn" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="handleAgreePrivacyAuthorization">{{lbl_privacy_modal_agree}}</button>
    </view>
  </view>

</view>

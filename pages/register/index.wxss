/* pages/register/index.wxss */

.container { display:flex; flex-direction:column; height:100vh; background:#0b0b0c; overflow:hidden; box-sizing:border-box; }

.topbar { background:#0b0b0c; padding:80rpx 28rpx 20rpx; border-bottom:1rpx solid #1a1a22; flex-shrink:0; display:flex; align-items:center; box-sizing:border-box; width:100%; }
.back-btn { width:60rpx; flex-shrink:0; }
.back-arrow { font-size:48rpx; color:#beb6b6; font-weight:300; }
.topbar-center { flex:1; text-align:center; }
.topbar-title { font-size:32rpx; font-weight:800; color:#f3f3f4; display:block; }
.topbar-sub { font-size:22rpx; color:#beb6b6; display:block; margin-top:4rpx; }
.topbar-right { width:60rpx; flex-shrink:0; }

.plan-badge { background:#1a0808; border-bottom:1rpx solid #2a1010; padding:18rpx 28rpx; display:flex; justify-content:space-between; align-items:center; flex-shrink:0; box-sizing:border-box; width:100%; }
.plan-badge-text { font-size:26rpx; color:#e94239; font-weight:700; }
.plan-badge-change { font-size:24rpx; color:#beb6b6; text-decoration:underline; }

.scroll { flex:1; padding:28rpx 28rpx; box-sizing:border-box; overflow-x:hidden; width:100%; }

.field { margin-bottom:36rpx; width:100%; box-sizing:border-box; }

.field-label {
  font-size:24rpx;
  color:#beb6b6;
  font-weight:700;
  letter-spacing:2rpx;
  display:block;
  margin-bottom:12rpx;
  text-transform:uppercase;
}

.field-input {
  background:#13131a;
  border:1rpx solid #2a2a33;
  border-radius:16rpx;
  padding:30rpx 28rpx;
  font-size:30rpx;
  color:#f3f3f4;
  width:100%;
  min-height:88rpx;
  box-sizing:border-box;
}

.field-input-warning {
  border-color:#ac1c1c;
}

.field-textarea {
  background:#13131a;
  border:1rpx solid #2a2a33;
  border-radius:16rpx;
  padding:30rpx 28rpx;
  font-size:30rpx;
  color:#f3f3f4;
  width:100%;
  height:88rpx;
  box-sizing:border-box;
}

.btn-wrap {
  padding:10rpx 0 80rpx;
  display:flex;
  flex-direction:column;
  gap:12rpx;
  box-sizing:border-box;
  width:100%;
}

button { margin:0 !important; padding:0 !important; background:transparent; border:none; }

.btn-primary {
  background:#e8342a !important;
  border-radius:24rpx !important;
  height:100rpx;
  line-height:100rpx;
  font-size:34rpx !important;
  font-weight:800 !important;
  color:#fff !important;
  width:100% !important;
  text-align:center;
  box-sizing:border-box;
  display:block;
}

.btn-disabled { opacity:0.5; }

.btn-hint {
  font-size:22rpx;
  color:#beb6b6;
  text-align:center;
  display:block;
}

/* ── PRIVACY CONSENT — checkbox obligatorio antes de registrarse ── */
.privacy-consent-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.privacy-checkbox {
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #4a4a52;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.privacy-checkbox-checked {
  background: #e8342a;
  border-color: #e8342a;
}
.privacy-checkbox text { font-size: 22rpx; color: #fff; line-height: 1; }

.privacy-consent-text {
  font-size: 22rpx;
  color: #beb6b6;
}

.privacy-link-inline {
  background: transparent !important;
  border: none !important;
  margin: 0 !important;
  padding: 0 !important;
  height: auto;
  line-height: normal;
  width: auto !important;
}
.privacy-link-inline::after { border: none; }
.privacy-link-inline text {
  font-size: 22rpx;
  color: #e8342a;
  text-decoration: underline;
}

/* Link a la política de privacidad (abre el contrato auto-generado por WeChat) */
.privacy-link {
  background: transparent !important;
  border: none !important;
  margin: 12rpx 0 0 !important;
  padding: 0 !important;
  height: auto;
  line-height: normal;
  width: auto !important;
}
.privacy-link::after { border: none; }
.privacy-link text {
  font-size: 22rpx;
  color: #e8342a;
  text-decoration: underline;
}

/* ── PRIVACY MODAL — pop-up oficial recomendado por WeChat, se muestra
   antes de completar el formulario cuando wx.getPrivacySetting() indica
   que este usuario todavía no aceptó la guía de privacidad ── */
.privacy-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.privacy-modal-card {
  width: 560rpx;
  background: #13131a;
  border: 1rpx solid #2a2a33;
  border-radius: 24rpx;
  padding: 44rpx 36rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.privacy-modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #f3f3f4;
  display: block;
  margin-bottom: 16rpx;
  text-align: center;
}

.privacy-modal-body {
  font-size: 26rpx;
  color: #beb6b6;
  line-height: 1.6;
  display: block;
  margin-bottom: 32rpx;
  text-align: center;
}

.privacy-modal-view-btn {
  background: transparent !important;
  border: 1rpx solid #4a4a52 !important;
  border-radius: 20rpx !important;
  height: 84rpx;
  line-height: 84rpx;
  color: #e8342a !important;
  font-size: 28rpx !important;
  font-weight: 700 !important;
  width: 100% !important;
  text-align: center;
  box-sizing: border-box;
  display: block;
  margin-bottom: 16rpx !important;
}
.privacy-modal-view-btn::after { border: none; }

.privacy-modal-agree-btn {
  background: #e8342a !important;
  border-radius: 20rpx !important;
  height: 84rpx;
  line-height: 84rpx;
  color: #fff !important;
  font-size: 28rpx !important;
  font-weight: 800 !important;
  width: 100% !important;
  text-align: center;
  box-sizing: border-box;
  display: block;
}
.privacy-modal-agree-btn::after { border: none; }

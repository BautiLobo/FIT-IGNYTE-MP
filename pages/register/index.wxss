/* pages/register/index.wxss — formulario de alta (mismo lenguaje que tiers / plans / meal-select) */

page { background:#0b0b0c; }

.container { display:flex; flex-direction:column; height:100vh; background:#0b0b0c; overflow:hidden; box-sizing:border-box; }

/* ── TOPBAR ── */
.topbar { background:#0b0b0c; padding:80rpx 32rpx 24rpx; border-bottom:1rpx solid #1a1a22; flex-shrink:0; display:flex; align-items:center; box-sizing:border-box; width:100%; }
.back-btn { width:64rpx; height:64rpx; background:#1a1a22; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.back-arrow { font-size:40rpx; color:#f3f3f4; line-height:1; font-weight:400; }
.topbar-center { flex:1; text-align:center; }
.topbar-title { font-size:34rpx; font-weight:800; color:#f3f3f4; display:block; }

/* ── SCROLL ── */
.scroll { flex:1; min-height:0; box-sizing:border-box; overflow-x:hidden; width:100%; }
.scroll-inner { padding:28rpx 32rpx; padding-bottom:calc(40rpx + env(safe-area-inset-bottom)); box-sizing:border-box; }

/* ── CAMPOS ── */
.field { margin-bottom:28rpx; width:100%; box-sizing:border-box; }
.field-label { display:block; font-size:20rpx; font-weight:800; letter-spacing:3rpx; text-transform:uppercase; color:#9a9aa3; margin-bottom:12rpx; }
.field-input, .field-textarea {
  background:#13131a; border:2rpx solid #2a2a33; border-radius:18rpx;
  padding:28rpx 26rpx; font-size:29rpx; font-weight:600; color:#f3f3f4;
  width:100%; box-sizing:border-box;
}
.field-input { min-height:92rpx; }
.field-textarea { min-height:92rpx; }
.field-input-warning { border-color:rgba(232,52,42,0.55); background:linear-gradient(160deg, rgba(232,52,42,0.10) 0%, #13131a 60%); }
.field-ph { color:#5d5d65; font-weight:500; }

/* ── BOTONES ── */
.btn-wrap { padding:12rpx 0 24rpx; display:flex; flex-direction:column; gap:16rpx; box-sizing:border-box; width:100%; }
button { margin:0 !important; padding:0 !important; background:transparent; border:none; }
.btn-primary {
  background:#e8342a !important; border-radius:24rpx !important;
  height:96rpx; line-height:96rpx;
  font-size:32rpx !important; font-weight:800 !important; letter-spacing:1rpx; color:#fff !important;
  width:100% !important; text-align:center; box-sizing:border-box; display:block;
  box-shadow:0 8rpx 30rpx rgba(232,52,42,0.35);
}
.btn-disabled { opacity:0.4; box-shadow:none; }
.btn-hint { font-size:22rpx; font-weight:500; color:#9a9aa3; text-align:center; display:block; line-height:1.45; }

/* ── PLAN ELEGIDO ── */
.plan-bar {
  display:flex; align-items:center; justify-content:space-between; gap:16rpx;
  border:2rpx solid rgba(232,52,42,0.45); border-radius:20rpx;
  background:linear-gradient(160deg, rgba(232,52,42,0.16) 0%, #13131a 60%);
  padding:20rpx 22rpx; margin-bottom:32rpx;
}
.plan-bar-info { flex:1; min-width:0; display:flex; flex-direction:column; gap:4rpx; }
.plan-bar-name { font-size:30rpx; font-weight:900; font-style:italic; text-transform:uppercase; letter-spacing:-0.5rpx; color:#f3f3f4; line-height:1.15; }
.plan-bar-price { font-size:22rpx; font-weight:800; letter-spacing:1.5rpx; text-transform:uppercase; color:#e8342a; }
.plan-bar-change { flex-shrink:0; background:#1a1a22; border:1rpx solid #2a2a33; border-radius:100rpx; padding:10rpx 20rpx; }
.plan-bar-change text { font-size:21rpx; font-weight:800; color:#f3f3f4; }

/* ── PRIVACIDAD ── */
.privacy-consent-row { display:flex; align-items:center; flex-wrap:wrap; gap:10rpx; margin:8rpx 0 24rpx; }
.privacy-checkbox { width:38rpx; height:38rpx; border:2rpx solid #3f3f45; border-radius:10rpx; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.privacy-checkbox-checked { background:#e8342a; border-color:#e8342a; box-shadow:0 4rpx 12rpx rgba(232,52,42,0.4); }
.privacy-checkbox text { font-size:22rpx; color:#fff; line-height:1; font-weight:900; }
.privacy-consent-text { font-size:23rpx; color:#9a9aa3; font-weight:500; }

.privacy-link-inline, .privacy-link { background:transparent !important; border:none !important; padding:0 !important; height:auto; line-height:normal; width:auto !important; }
.privacy-link-inline { margin:0 !important; }
.privacy-link { margin:4rpx auto 0 !important; }
.privacy-link-inline::after, .privacy-link::after { border:none; }
.privacy-link-inline text, .privacy-link text { font-size:23rpx; font-weight:700; color:#e8342a; text-decoration:underline; }

/* ── MODAL DE PRIVACIDAD (WeChat) ── */
.privacy-modal-mask { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,.7); display:flex; align-items:center; justify-content:center; z-index:999; }
.privacy-modal-card { width:600rpx; background:#13131a; border:2rpx solid #2a2a33; border-radius:28rpx; padding:44rpx 36rpx 36rpx; box-sizing:border-box; display:flex; flex-direction:column; align-items:stretch; }
.privacy-modal-title { font-size:36rpx; font-weight:900; font-style:italic; text-transform:uppercase; letter-spacing:-0.5rpx; color:#f3f3f4; display:block; margin-bottom:16rpx; text-align:center; }
.privacy-modal-body { font-size:25rpx; color:#9a9aa3; line-height:1.55; display:block; margin-bottom:32rpx; text-align:center; }
.privacy-modal-view-btn {
  background:#1a1a22 !important; border:1rpx solid #2a2a33 !important; border-radius:20rpx !important;
  height:84rpx; line-height:84rpx; color:#f3f3f4 !important; font-size:28rpx !important; font-weight:700 !important;
  width:100% !important; text-align:center; box-sizing:border-box; display:block; margin-bottom:16rpx !important;
}
.privacy-modal-agree-btn {
  background:#e8342a !important; border-radius:20rpx !important;
  height:84rpx; line-height:84rpx; color:#fff !important; font-size:28rpx !important; font-weight:800 !important;
  width:100% !important; text-align:center; box-sizing:border-box; display:block;
  box-shadow:0 8rpx 24rpx rgba(232,52,42,0.35);
}
.privacy-modal-view-btn::after, .privacy-modal-agree-btn::after { border:none; }

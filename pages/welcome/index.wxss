/* pages/welcome/index.wxss — mismo lenguaje que tiers / plans / calendario */

page { background:#0b0b0c; }

.container { display:flex; flex-direction:column; height:100vh; background:#0b0b0c; overflow:hidden; }

.content {
  flex:1; min-height:0;
  display:flex; flex-direction:column;
  padding:0 32rpx; padding-bottom:calc(48rpx + env(safe-area-inset-bottom));
  box-sizing:border-box;
  background:radial-gradient(ellipse at 50% 38%, rgba(232,52,42,0.18) 0%, transparent 55%);
}

/* ── HERO ── */
.hero { flex-shrink:0; display:flex; flex-direction:column; align-items:center; text-align:center; }
.hero-logo { width:120rpx; height:240rpx; margin-bottom:40rpx; filter:drop-shadow(0 8rpx 30rpx rgba(232,52,42,0.35)); }

.headline {
  font-size:60rpx; font-weight:900; font-style:italic; letter-spacing:-2rpx; text-transform:uppercase;
  color:#f3f3f4; line-height:1.08; display:block;
  text-shadow:0 6rpx 28rpx rgba(232,52,42,0.25);
}
.header-divider { width:56rpx; height:6rpx; background:#e8342a; border-radius:6rpx; margin-top:18rpx; }

.spacer { flex:1; min-height:40rpx; }
.spacer-bottom { flex:1.4; }
.btn-wrap { margin-top:80rpx !important; }

/* ── BOTÓN ── */
button { margin:0 !important; padding:0 !important; background:transparent; border:none; }
.btn-primary {
  background:#e8342a !important; border-radius:24rpx !important;
  height:96rpx; line-height:96rpx;
  font-size:32rpx !important; font-weight:800 !important; letter-spacing:1rpx; color:#fff !important;
  width:100% !important; text-align:center; box-sizing:border-box; display:block; flex-shrink:0;
  box-shadow:0 8rpx 30rpx rgba(232,52,42,0.35);
}

<view class="container">

  <view class="content">

    <view class="spacer"></view>

    <view class="hero">
      <image class="hero-logo" src="/images/mark.png" mode="aspectFit" />
      <text class="headline">{{lbl_title}}</text>
      <view class="header-divider"></view>
    </view>

    <button class="btn-primary btn-wrap" bindtap="goToHome">{{lbl_go_home}}</button>

    <view class="spacer spacer-bottom"></view>

  </view>

</view>

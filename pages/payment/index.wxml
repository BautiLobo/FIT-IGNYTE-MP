<view class="container">

  <view class="topbar">
    <view class="back-btn" bindtap="goBack"><text class="back-arrow">‹</text></view>
    <text class="topbar-title">{{lbl_title}}</text>
    <view style="width:64rpx;"></view>
  </view>

  <scroll-view class="scroll" scroll-y>
   <view class="scroll-inner">

    <!-- Resumen -->
    <view class="card">
      <text class="card-label">{{lbl_order_summary}}</text>

      <view class="plan-line">
        <text class="plan-name">{{selectedPlan.displayName}}</text>
        <text class="plan-sub">{{selectedPlan.meals}} {{lbl_meals_day}}</text>
      </view>

      <view class="row row-border">
        <text class="row-key">{{lbl_plan_price}}</text>
        <text class="row-val {{discount > 0 ? 'row-val-strike' : ''}}">¥{{selectedPlan.price}}</text>
      </view>

      <view class="row row-border" wx:if="{{discount > 0}}">
        <text class="row-key row-green">{{lbl_first_week}}</text>
        <text class="row-val row-green">−¥{{discount}}</text>
      </view>

      <view class="row row-border">
        <text class="row-key">{{lbl_delivery}}</text>
        <text class="row-val">¥{{deliveryFee}}</text>
      </view>

      <view class="row row-border" wx:if="{{discountApplied}}">
        <text class="row-key row-green">{{lbl_discount_row}}</text>
        <text class="row-val row-green">−¥{{discountAmount}}</text>
      </view>

      <view class="row row-border" wx:if="{{referralApplied}}">
        <text class="row-key row-green">{{lbl_referral_row}}</text>
        <text class="row-val row-green">−¥{{referralDiscount}}</text>
      </view>

      <view class="row row-total">
        <text class="row-total-key">{{lbl_total}}</text>
        <text class="row-total-val">¥{{total}}</text>
      </view>
    </view>

    <!-- Código de referido: solo en alta nueva, no en renovación (create-payment
         lo ignora igual del lado del servidor si viene de una renovación) -->
    <view class="card" wx:if="{{!referralAlreadyUsed && !fromRenewal}}">
      <text class="card-label">{{lbl_referral_label}}</text>

      <view class="code-row" wx:if="{{!referralApplied}}">
        <input class="code-input" placeholder-class="code-ph" placeholder="{{lbl_referral_placeholder}}" value="{{referralInput}}" bindinput="onReferralInput" />
        <view class="code-btn {{referralChecking ? 'code-btn-disabled' : ''}}" bindtap="applyReferral">
          <text>{{lbl_referral_apply}}</text>
        </view>
      </view>

      <view class="code-applied" wx:else>
        <text class="code-applied-code">{{referralCode}}</text>
        <text class="code-applied-check">✓ {{lbl_referral_applied}}</text>
      </view>
    </view>

    <!-- Código de descuento de un solo uso: solo en renovación. Los de coach
         no sirven acá (create-payment busca en discount_codes, no en coaches) -->
    <view class="card" wx:if="{{fromRenewal}}">
      <text class="card-label">{{lbl_discount_label}}</text>

      <view class="code-row" wx:if="{{!discountApplied}}">
        <input class="code-input" placeholder-class="code-ph" placeholder="{{lbl_discount_placeholder}}" value="{{discountInput}}" bindinput="onDiscountInput" />
        <view class="code-btn {{discountChecking ? 'code-btn-disabled' : ''}}" bindtap="applyDiscountCode">
          <text>{{lbl_referral_apply}}</text>
        </view>
      </view>

      <view class="code-applied" wx:else>
        <text class="code-applied-code">{{discountCode}}</text>
        <text class="code-applied-check">✓ {{lbl_discount_applied}}</text>
      </view>
    </view>

    <!-- Método de pago -->
    <text class="section-label">{{lbl_method}}</text>

    <view class="wechat-pay-btn {{submitting ? 'wechat-pay-btn-disabled' : ''}}" hover-class="wechat-pay-hover" bindtap="payNow">
      <view class="wechat-pay-left">
        <text class="wechat-pay-title">{{lbl_wechat_pay}}</text>
        <text class="wechat-pay-sub">{{lbl_tap_to_pay}}</text>
      </view>
      <text class="wechat-pay-amount">¥{{total}}</text>
    </view>

    <text class="pay-hint">{{lbl_renewal_note}}</text>

    <view class="contact-link-row btn-mb">
      <text class="contact-link-q">{{lbl_any_doubt}}</text>
      <button class="contact-link" hover-class="contact-link-hover" open-type="contact">{{lbl_contact_btn}}</button>
    </view>

    <!-- Start over: solo en alta nueva, no en renovación -->
    <button class="btn-secondary" wx:if="{{!fromRenewal}}" bindtap="startOver">{{lbl_start_over_btn}}</button>

   </view>
  </scroll-view>

</view>

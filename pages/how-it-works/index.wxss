/* pages/how-it-works/index.wxss — mismo lenguaje que tiers / plans / calendario */

page { background:#0b0b0c; }

.container { display:flex; flex-direction:column; height:100vh; background:#0b0b0c; overflow:hidden; }

/* ── TOPBAR ── */
.topbar { background:#0b0b0c; padding:80rpx 32rpx 24rpx; border-bottom:1rpx solid #1a1a22; display:flex; align-items:center; flex-shrink:0; }
.back-btn { width:64rpx; height:64rpx; background:#1a1a22; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.back-arrow { font-size:40rpx; color:#f3f3f4; line-height:1; }
.topbar-title { flex:1; text-align:center; font-size:34rpx; font-weight:800; color:#f3f3f4; }

/* ── SCROLL ── */
.scroll { flex:1; min-height:0; box-sizing:border-box; overflow-x:hidden; }
.scroll-inner { display:flex; flex-direction:column; min-height:100%; padding:20rpx 32rpx; padding-bottom:calc(20rpx + env(safe-area-inset-bottom)); box-sizing:border-box; }
.spacer { flex:1; min-height:20rpx; }

/* ── HEADER ── */
.header-block { display:flex; flex-direction:column; align-items:center; margin-bottom:34rpx; }
.kicker-pill { background:rgba(232,52,42,0.12); border:1rpx solid rgba(232,52,42,0.35); border-radius:100rpx; padding:8rpx 20rpx; }
.kicker { font-size:19rpx; color:#e8342a; font-weight:800; letter-spacing:4rpx; text-transform:uppercase; display:block; line-height:1.2; }
.headline-wrap { display:flex; flex-direction:column; align-items:center; margin-top:18rpx; }
.headline {
  font-size:52rpx; font-weight:900; font-style:italic; letter-spacing:-1.5rpx; text-transform:uppercase;
  color:#f3f3f4; line-height:1.08; display:block; text-align:center;
  text-shadow:0 6rpx 28rpx rgba(232,52,42,0.18);
}
.header-divider { width:56rpx; height:6rpx; background:#e8342a; border-radius:6rpx; margin-top:16rpx; }
.intro { font-size:26rpx; font-weight:500; color:#9a9aa3; line-height:1.45; display:block; text-align:center; margin-top:14rpx; max-width:560rpx; }

/* ── TIMELINE ── */
.timeline { display:flex; flex-direction:column; }
.step-row { display:flex; gap:20rpx; }
.step-marker { display:flex; flex-direction:column; align-items:center; flex-shrink:0; }
.step-circle {
  width:64rpx; height:64rpx; border-radius:50%;
  background:#e8342a; color:#fff;
  font-size:30rpx; font-weight:900; font-style:italic;
  line-height:64rpx; text-align:center;
  box-shadow:0 6rpx 20rpx rgba(232,52,42,0.4);
}
.step-line { width:4rpx; flex:1; background:linear-gradient(#e8342a, rgba(232,52,42,0.15)); border-radius:4rpx; margin:8rpx 0; }

.step-content {
  flex:1; min-width:0;
  padding:24rpx 24rpx 26rpx;
  background:linear-gradient(160deg, rgba(232,52,42,0.10) 0%, #13131a 55%);
  border:2rpx solid #2a2a33; border-radius:22rpx;
  margin-bottom:20rpx; box-sizing:border-box;
}
.step-row-last .step-content { margin-bottom:0; }
.step-head { display:flex; align-items:center; gap:14rpx; margin-bottom:10rpx; }
.step-title { flex:1; font-size:31rpx; font-weight:900; font-style:italic; text-transform:uppercase; letter-spacing:-0.5rpx; color:#f3f3f4; }
.step-tag {
  flex-shrink:0;
  font-size:18rpx; font-weight:800; letter-spacing:1.5rpx; text-transform:uppercase; color:#e8342a;
  background:rgba(232,52,42,0.12); border:1rpx solid rgba(232,52,42,0.35);
  padding:6rpx 14rpx; border-radius:100rpx;
}
.step-desc { font-size:26rpx; color:#9a9aa3; line-height:1.45; display:block; }

/* ── BOTÓN ── */
.btn-wrap { width:100%; }
button { margin:0 !important; padding:0 !important; background:transparent; border:none; }
.btn-start {
  background:#e8342a !important; border-radius:24rpx !important;
  height:96rpx; line-height:96rpx;
  color:#fff !important; font-size:32rpx !important; font-weight:800 !important; letter-spacing:1rpx;
  text-align:center; width:100% !important; box-sizing:border-box; display:block;
  box-shadow:0 8rpx 30rpx rgba(232,52,42,0.35);
}

/* ── FOTOS DE COMIDAS (paso 2) ── */
.meal-strip { display:flex; gap:10rpx; margin-top:16rpx; }
.meal-strip-img { flex:1; height:124rpx; border-radius:14rpx; background:#1a1a22; border:2rpx solid #2a2a33; box-sizing:border-box; }

/* ── CONTACTO ── */
.contact-row { display:flex; justify-content:center; align-items:center; gap:10rpx; margin-top:18rpx; }
.contact-q { font-size:24rpx; font-weight:600; color:#9a9aa3; }
.contact-link { display:inline-block !important; width:auto !important; font-size:24rpx !important; font-weight:800 !important; color:#e8342a !important; line-height:1.4 !important; text-decoration:underline; }
.contact-link::after { border:none; }

/* pages/pay-processing/index.wxss — mismo lenguaje que tiers / plans / calendario */

page { background:#0b0b0c; }

.container { display:flex; flex-direction:column; height:100vh; background:#0b0b0c; }

.content {
  flex:1;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  padding:40rpx 32rpx; text-align:center;
  background:radial-gradient(ellipse at 50% 42%, rgba(232,52,42,0.10) 0%, transparent 55%);
}

/* ── ANILLO ── */
.ring-wrap { position:relative; width:200rpx; height:200rpx; display:flex; align-items:center; justify-content:center; margin-bottom:40rpx; }
.ring-spin {
  position:absolute; width:200rpx; height:200rpx; border-radius:50%; box-sizing:border-box;
  border:6rpx solid #1a1a22; border-top-color:#e8342a;
  animation:spin 0.9s linear infinite;
}
.ring-core {
  width:140rpx; height:140rpx; border-radius:50%;
  background:rgba(232,52,42,0.12); border:4rpx solid rgba(232,52,42,0.45);
  display:flex; align-items:center; justify-content:center;
  animation:breathe 1.4s ease-in-out infinite;
}
.ring-core-done { background:rgba(52,211,153,0.12); border-color:#34D399; box-shadow:0 0 60rpx rgba(52,211,153,0.3); animation:none; }
.ring-check { font-size:80rpx; font-weight:900; color:#34D399; line-height:1; }

@keyframes spin { to { transform:rotate(360deg); } }
@keyframes breathe { 0%,100% { transform:scale(1); } 50% { transform:scale(1.06); } }

/* ── TEXTO ── */
.headline {
  font-size:50rpx; font-weight:900; font-style:italic; letter-spacing:-1.5rpx; text-transform:uppercase;
  color:#f3f3f4; line-height:1.1; display:block;
  text-shadow:0 6rpx 28rpx rgba(232,52,42,0.18);
}
.header-divider { width:56rpx; height:6rpx; background:#e8342a; border-radius:6rpx; margin-top:16rpx; }
.header-divider-done { background:#34D399; }
.intro { font-size:26rpx; font-weight:500; color:#9a9aa3; line-height:1.5; display:block; margin-top:14rpx; max-width:560rpx; }

/* ── PUNTOS ── */
.dots { display:flex; gap:14rpx; align-items:center; margin-top:36rpx; }
.dot { width:14rpx; height:14rpx; background:#e8342a; border-radius:50%; }
.dot-1 { animation:bounce 1.2s ease-in-out 0s infinite; }
.dot-2 { animation:bounce 1.2s ease-in-out 0.2s infinite; }
.dot-3 { animation:bounce 1.2s ease-in-out 0.4s infinite; }
@keyframes bounce { 0%,100% { transform:translateY(0); opacity:0.3; } 50% { transform:translateY(-12rpx); opacity:1; } }

<view class="container">

  <view class="topbar">
    <image class="topbar-logo" src="/images/mark.png" mode="aspectFit" />
  </view>

  <view class="content">

    <view class="hero">
      <view class="status-ring">
        <text class="status-check">✓</text>
      </view>
      <text class="headline">{{lbl_title}}</text>
      <view class="header-divider"></view>
      <text class="intro">{{lbl_welcome}}</text>
    </view>

    <view class="spacer"></view>

    <button class="btn-primary" bindtap="goToPayment">{{lbl_payment_btn}}</button>

  </view>

</view>

<view class="container">

  <view class="topbar">
    <image style="position: relative; left: 0rpx; top: -51rpx; width: 300rpx; height: 520rpx; display: block; box-sizing: border-box" class="topbar-logo" src="/images/logo.png" mode="aspectFit" />
  </view>

  <view class="content" style="position: relative; left: 0rpx; top: -372rpx">

    <view class="circle-wrap">
      <view class="hero-circle">
        <text class="hero-check">✓</text>
      </view>
    </view>

    <view class="title-wrap">
      <text class="hero-title">{{lbl_title}}</text>
    </view>

    <view class="sub-wrap">
      <text class="hero-sub">{{lbl_welcome}}</text>
    </view>


    <view class="btn-wrap">
      <button class="btn-primary" bindtap="goToPayment">{{lbl_payment_btn}}</button>
    </view>

  </view>

</view>

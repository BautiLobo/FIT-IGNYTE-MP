/* pages/approved/index.wxss — mismo lenguaje que tiers / plans / calendario */

page { background:#0b0b0c; }

.container { display:flex; flex-direction:column; height:100vh; background:#0b0b0c; overflow:hidden; }

.topbar { padding:80rpx 32rpx 24rpx; border-bottom:1rpx solid #1a1a22; flex-shrink:0; display:flex; align-items:center; justify-content:center; }
.topbar-logo { width:72rpx; height:72rpx; }

.content {
  flex:1; min-height:0;
  display:flex; flex-direction:column;
  padding:0 32rpx; padding-bottom:calc(40rpx + env(safe-area-inset-bottom));
  box-sizing:border-box;
  background:radial-gradient(ellipse at 50% 30%, rgba(52,211,153,0.10) 0%, transparent 55%);
}

/* ── HERO ── */
.hero { flex-shrink:0; display:flex; flex-direction:column; align-items:center; text-align:center; padding-top:18vh; }

.status-ring {
  width:180rpx; height:180rpx; border-radius:50%;
  background:rgba(52,211,153,0.12); border:4rpx solid #34D399;
  box-shadow:0 0 60rpx rgba(52,211,153,0.3);
  display:flex; align-items:center; justify-content:center;
  margin-bottom:36rpx;
}
.status-check { font-size:96rpx; font-weight:900; color:#34D399; line-height:1; }

.headline {
  font-size:56rpx; font-weight:900; font-style:italic; letter-spacing:-1.5rpx; text-transform:uppercase;
  color:#f3f3f4; line-height:1.1; display:block;
  text-shadow:0 6rpx 28rpx rgba(232,52,42,0.18);
}
.header-divider { width:56rpx; height:6rpx; background:#e8342a; border-radius:6rpx; margin-top:16rpx; }
.intro { font-size:27rpx; font-weight:500; color:#9a9aa3; line-height:1.5; display:block; margin-top:16rpx; max-width:580rpx; }

.spacer { flex:1; min-height:40rpx; }

/* ── BOTÓN ── */
button { margin:0 !important; padding:0 !important; background:transparent; border:none; }
.btn-primary {
  background:#e8342a !important; border-radius:24rpx !important;
  height:96rpx; line-height:96rpx;
  font-size:32rpx !important; font-weight:800 !important; letter-spacing:1rpx; color:#fff !important;
  width:100% !important; text-align:center; box-sizing:border-box; display:block; flex-shrink:0;
  box-shadow:0 8rpx 30rpx rgba(232,52,42,0.35);
}

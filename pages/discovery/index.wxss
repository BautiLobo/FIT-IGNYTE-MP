/* pages/discovery/index.wxss */

.container {
  min-height: 100vh;
  background: #0b0b0c;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  padding-bottom: 20rpx;
}

/* Header */
.header {
  width: 100%;
  padding: 20rpx 28rpx 16rpx;
  text-align: left;
  box-sizing: border-box;
  border-bottom: 1rpx solid #2a2a33;
}

.header-text {
  font-size: 18rpx;
  font-weight: 600;
  color: #e8342a;
  letter-spacing: 3rpx;
  display: block;
}

/* Logo section */
.logo-section {
  padding: 24rpx 0 20rpx;
  text-align: center;
}

.logo {
  width: 220rpx;
  height: 120rpx;
}

/* Hero section — large but not full screen */
.hero-section {
  position: relative;
  width: calc(100% - 56rpx);
  max-width: 480rpx;
  height: 380rpx;
  margin: 0 28rpx 32rpx;
  overflow: hidden;
  border-radius: 20rpx;
}

.hero-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
}

.hero-overlay {
  position: absolute;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.5) 100%);
  top: 0;
  left: 0;
}

.hero-content {
  position: absolute;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 36rpx 28rpx;
  box-sizing: border-box;
  z-index: 1;
}

/* Headline section */
.headline-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  margin-bottom: 16rpx;
  text-align: center;
}

.headline {
  font-size: 40rpx;
  font-weight: 900;
  font-style: italic;
  color: #f3f3f4;
  line-height: 1.3;
  display: block;
}

.headline-red {
  font-size: 40rpx;
  font-weight: 900;
  font-style: italic;
  color: #e8342a;
  line-height: 1.3;
  display: block;
}

/* Taglines */
.tagline-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  text-align: center;
}

.tagline {
  font-size: 24rpx;
  font-weight: 700;
  font-style: italic;
  color: #e8342a;
  line-height: 1.3;
  display: block;
}

/* Features tags */
.features {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.feature-tag {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  border: 1rpx solid #2a2a33;
  border-radius: 20rpx;
  padding: 8rpx 14rpx;
  background: rgba(26,26,34,0.6);
}

.feature-icon {
  font-size: 18rpx;
}

.feature-label {
  font-size: 18rpx;
  font-weight: 600;
  color: #9f9fa8;
  display: block;
}

/* Trusted text */
.trusted-text {
  font-size: 18rpx;
  font-weight: 600;
  color: #5d5d65;
  text-align: center;
  margin-bottom: 28rpx;
  display: block;
}

/* Promo badge */
.promo-badge {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid #e8342a;
  border-radius: 28rpx;
  padding: 16rpx 22rpx;
  background: rgba(232,52,42,0.08);
  margin-bottom: 32rpx;
  width: calc(100% - 56rpx);
  max-width: 360rpx;
  box-sizing: border-box;
}

.promo-off {
  font-size: 38rpx;
  font-weight: 900;
  font-style: italic;
  color: #e8342a;
  display: block;
  min-width: 70rpx;
  line-height: 1;
}

.promo-divider {
  width: 1rpx;
  height: 48rpx;
  background: #e8342a;
}

.promo-right {
  display: flex;
  flex-direction: column;
  gap: 3rpx;
  flex: 1;
}

.promo-trial {
  font-size: 22rpx;
  font-weight: 900;
  font-style: italic;
  color: #fff;
  display: block;
  line-height: 1.1;
}

.promo-note {
  font-size: 16rpx;
  font-weight: 600;
  color: #7d7d85;
  display: block;
}

/* Button */
button { margin: 0 !important; padding: 0 !important; background: transparent; border: none; }

.btn-start {
  background: #e8342a !important;
  border-radius: 28rpx !important;
  height: 88rpx;
  line-height: 88rpx;
  color: #fff !important;
  font-size: 32rpx !important;
  font-weight: 800 !important;
  text-align: center;
  width: calc(100% - 56rpx) !important;
  max-width: 360rpx;
  box-sizing: border-box;
  display: block;
  letter-spacing: 0.5rpx;
  margin-bottom: 28rpx;
}

/* Pricing footer */
.pricing-text {
  font-size: 16rpx;
  font-weight: 600;
  color: #5d5d65;
  text-align: center;
  display: block;
}

/* ═══════════════════════════════════════════════════════════════
   FIT IGNYTE — Discovery Landing
   Estructura: hero-bg (foto fondo) → body (contenido) → cta-section
   ═══════════════════════════════════════════════════════════════ */

/* Paleta de colores del sistema */
:root, page {
  --r:    #e8342a;   /* rojo primario */
  --bg:   #0b0b0c;   /* fondo negro */
  --tx:   #f3f3f4;   /* texto blanco */
  --t2:   #9f9fa8;   /* texto gris medio */
  --t3:   #5d5d65;   /* texto gris oscuro */
}

/* Contenedor de página: columna full-height, sin scroll */
.container {
  position: relative;
  width: 100%;
  height: 100vh;
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ── HERO: foto a sangre completa detrás del contenido ── */
.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  height: 840rpx;        /* la foto ocupa la mitad superior de la pantalla */
  object-fit: cover;
  z-index: 1;
}

/* Overlay de 5 stops: funde la foto a negro arriba y abajo,
   deja el centro visible; suma dos glows rojos atmosféricos */
.hero-bg::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background:
    linear-gradient(to bottom,
      rgba(11,11,12,.90) 0%,
      rgba(11,11,12,.82) 30%,
      rgba(11,11,12,.46) 48%,
      rgba(11,11,12,.82) 76%,
      #0b0b0c 100%),
    radial-gradient(circle at 50% 26%, rgba(232,52,42,.20) 0%, transparent 48%),
    radial-gradient(circle at 50% 92%, rgba(232,52,42,.08) 0%, transparent 40%);
  z-index: 2;
  pointer-events: none;
}

/* Textura de puntos sutiles sobre toda la zona del hero */
.hero-bg::before {
  content: '';
  position: absolute;
  top: 100px;
  left: 0;
  width: 100%;
  height: 400%;
  background-image: radial-gradient(rgba(255,255,255,.02) 1px, transparent 1px);
  background-size: 22rpx 22rpx;
  z-index: 3;
  pointer-events: none;
}

/* ── BODY: todo el contenido; flex-end lo ancla al fondo ── */
.body {
  position: relative;
  z-index: 10;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;   /* el contenido cae al fondo, no queda arriba */
  text-align: center;
  padding: 84rpx 22rpx 4rpx;   /* 84rpx arriba reserva el safe area / cápsula */
  overflow: hidden;
}

/* Logo: flota en la zona de la foto; margin-bottom:auto
   empuja todo lo demás hacia abajo */
.logo-float {
  margin-bottom: auto;
  padding-top: 54rpx;
  height: auto;
}

.logo {
  width: 302rpx;               /* logo grande centrado sobre la foto */
  height: auto;
  aspect-ratio: 1 / .79;
  filter: drop-shadow(0 10rpx 26rpx rgba(232,52,42,.28));  /* glow rojo */
}

/* ── HEADLINE: 3 líneas exactas, la tercera en rojo (WXML) ── */
.headline-block {
  margin-bottom: 20rpx;
}

.headline {
  font-size: 50rpx;
  font-weight: 800;
  font-style: italic;
  color: var(--tx);
  line-height: 1.2;
  letter-spacing: -0.7rpx;
  text-transform: uppercase;
  text-shadow: 0 2rpx 18rpx rgba(0,0,0,.85);  /* legible sobre la foto */
  display: block;
  white-space: nowrap;         /* nunca partir a mitad de frase */
}

/* Los <text class="break"> fuerzan el salto de línea exacto */
.headline .break {
  display: block;
  height: 0;
}

/* Última línea del headline en rojo */
.headline-red {
  color: var(--r);
}

/* ── RULE: regla roja separadora headline/tagline ── */
.rule {
  width: 42rpx;
  height: 3rpx;
  background: var(--r);
  border-radius: 3rpx;
  margin: 12rpx auto;
}

/* ── TAGLINE: 2 líneas rojas, corta en el · ── */
.tagline-block {
  margin-bottom: 24rpx;
}

.tagline {
  font-size: 34rpx;
  font-weight: 800;
  font-style: italic;
  color: var(--r);
  line-height: 1.3;
  letter-spacing: -0.4rpx;
  text-transform: uppercase;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,.6);
  display: block;
  white-space: nowrap;
}

.tagline .break {
  display: block;
  height: 0;
}

/* ── CHIPS: 3 en una sola fila, nunca se envuelven ── */
.chips-row {
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 6rpx;                   /* separación entre chips */
  margin-bottom: 220rpx;
  padding: 0;
  flex-wrap: nowrap;
}

.chip {
  flex: 0 0 auto;              /* tamaño fijo, no se estira ni comprime */
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;                   /* espacio icono-texto */
  background: transparent;
  border: 2rpx solid rgba(232,52,42,.40);   /* borde rojo translúcido */
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--t2);
  text-transform: uppercase;
  white-space: nowrap;
}

/* Íconos PNG rojos (delivery / cart / utensils) */
.chip-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.chip-text {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--t2);
  white-space: nowrap;
}

/* ── FRESH COPY: línea bajo los chips ── */
.fresh-copy {
  font-size: 36rpx;
  font-weight: 800;
  font-style: italic;
  color: var(--tx);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
  display: block;
  white-space: nowrap;
}

/* ── TRUST COPY: prueba social, "100+" resaltado en blanco ── */
.trust-copy {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--t2);
  margin-bottom: 18rpx;
  display: block;
  white-space: nowrap;
}

.trust-bold {
  color: var(--tx);
  font-weight: 700;
}

/* ── PROMO BADGE: [25% OFF] │ [FIRST WEEK TRIAL / note] ── */
.promo-badge {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  width: 100%;                 /* full-width dentro del padding del body */
  background: linear-gradient(100deg, rgba(232,52,42,.16), rgba(232,52,42,.06));
  border: 2rpx solid rgba(232,52,42,.40);
  border-radius: 24rpx;        /* mismo radio que el botón de how-it-works */
  padding: 36rpx 28rpx;
  margin-bottom: 44rpx;
  box-sizing: border-box;
}

/* "25% OFF" grande en rojo, una línea */
.badge-off {
  font-size: 50rpx;
  font-weight: 800;
  font-style: italic;
  color: var(--r);
  letter-spacing: -0.8rpx;
  text-transform: uppercase;
  line-height: 1;
  white-space: nowrap;
  flex-shrink: 0;
}

/* Barra vertical separadora dentro del badge */
.badge-divider {
  width: 2rpx;
  height: 40rpx;
  background: rgba(232,52,42,.40);
  flex-shrink: 0;
}

/* Bloque derecho del badge, alineado a la izquierda */
.badge-right {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  text-align: left;
}

.badge-trial {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--tx);
  text-transform: uppercase;
  line-height: 1;
  display: block;
  white-space: nowrap;         /* "FIRST WEEK TRIAL" en una sola línea */
}

.badge-note {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--t3);
  display: block;
  white-space: nowrap;         /* "New customers only" en una sola línea */
}

/* ── CTA SECTION: botón + micro-copy, pegados al fondo ── */
.cta-section {
  position: relative;
  z-index: 20;
  padding: 19rpx 22rpx 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9rpx;                   /* espacio botón ↔ micro-copy */
  flex-shrink: 0;              /* nunca se comprime */
}

/* Reset de estilos nativos de button en WeChat */
button { margin: 0 !important; padding: 0 !important; }

/* Botón rojo principal — idéntico a .btn-start de how-it-works */
.btn-cta {
  background: #e8342a !important;
  border-radius: 24rpx !important;
  height: 96rpx;
  line-height: 96rpx;
  color: #fff !important;
  font-size: 32rpx !important;
  font-weight: 800 !important;
  text-align: center;
  width: 100% !important;
  box-sizing: border-box;
  display: block;
  box-shadow: 0 8rpx 30rpx rgba(232,52,42,0.35);
}

/* Micro-copy bajo el botón, "¥41/meal" resaltado en blanco */
.cta-footer {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--t3);
  text-align: center;
  display: block;
  white-space: nowrap;
}

.pricing-bold {
  color: var(--tx);
  font-weight: 700;
}

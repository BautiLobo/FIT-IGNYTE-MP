<view class="container">

  <!-- Top Bar -->
  <view class="topbar">
    <view class="back-btn" bindtap="goBack"><text class="back-arrow">‹</text></view>
    <text class="topbar-title">{{lbl_title}}</text>
    <view style="width:64rpx;"></view>
  </view>

  <!-- Day Tabs -->
  <view class="day-tabs">
    <view
      wx:for="{{days}}"
      wx:key="key"
      class="day-tab {{currentDay === item.key ? 'day-tab-active' : ''}} {{item.done ? 'day-tab-done' : ''}}"
      bindtap="switchDay"
      data-day="{{item.key}}"
    >
      <text class="day-tab-weekday">{{item.shortWeekday}}</text>
      <text class="day-tab-date">{{item.shortDate}}</text>
      <view class="day-tab-dot"></view>
    </view>
  </view>

  <scroll-view class="scroll" scroll-y>
    <view class="scroll-inner">

      <block wx:if="{{loading}}">
        <view class="loading-wrap"><view class="spinner"></view></view>
      </block>

      <block wx:else>

        <!-- Plan -->
        <view class="plan-bar" wx:if="{{!fromHome}}" style="border-color:{{planTintBorder}}; background:{{planTint}};">
          <view class="plan-bar-info">
            <text class="plan-bar-name" style="color:{{planColor}};">{{planTitle}}</text>
            <text class="plan-bar-meals">{{lbl_plan_meals}}</text>
          </view>
          <view class="plan-bar-change" bindtap="changePlan"><text>{{lbl_change_plan}}</text></view>
        </view>

        <!-- Día actual + progreso de comidas -->
        <view class="day-head">
          <text class="day-head-title">{{currentDayShort}}</text>
          <view class="day-head-progress">
            <view class="slots">
              <view wx:for="{{mealSlots}}" wx:key="index" class="slot {{item ? 'slot-on' : ''}} {{dayConfirmed ? 'slot-done' : ''}}"></view>
            </view>
            <text class="day-head-count {{dayConfirmed ? 'day-head-count-done' : ''}}">{{lbl_day_progress}}</text>
          </view>
        </view>

        <!-- Foto grande de la última comida tocada -->
        <view wx:if="{{lastSelectedPhoto}}" class="photo-preview-wrap">
          <image class="photo-preview-img" src="{{lastSelectedPhoto}}" mode="aspectFill" />
          <view class="photo-preview-overlay">
            <text class="photo-preview-name">{{lastSelectedName}}</text>
          </view>
        </view>

        <!-- Comidas -->
        <view class="meal-list">
          <view
            wx:for="{{menuMeals}}"
            wx:key="id"
            class="meal-card {{item.qty > 0 ? 'meal-card-selected' : ''}}"
            hover-class="meal-card-hover"
            bindtap="previewMeal"
            data-meal="{{item}}"
          >
            <view class="meal-thumb-wrap">
              <image wx:if="{{item.photo_url}}" class="meal-thumb" src="{{item.photo_url}}" mode="aspectFill" />
              <view wx:else class="meal-thumb-placeholder">
                <text class="meal-thumb-label">{{item.displayName.substring(0,4).toUpperCase()}}</text>
              </view>
              <view class="meal-qty-badge" wx:if="{{item.qty > 0}}"><text>{{item.qty}}</text></view>
            </view>

            <view class="meal-info">
              <text class="meal-name">{{item.displayName}}</text>
              <view class="macros">
                <text class="macro macro-kcal">{{item.kcal}} {{lbl_kcal}}</text>
                <text class="macro macro-p">{{lbl_protein}} {{item.protein}}g</text>
                <text class="macro macro-c">{{lbl_carbs}} {{item.carbs}}g</text>
                <text class="macro macro-f">{{lbl_fat}} {{item.fat}}g</text>
              </view>
            </view>

            <view class="meal-stepper">
              <view class="stepper-btn stepper-btn-minus {{item.qty === 0 ? 'stepper-btn-disabled' : ''}}" catchtap="decrementMeal" data-meal="{{item}}">
                <text class="stepper-btn-text">−</text>
              </view>
              <text class="stepper-qty {{item.qty > 0 ? 'stepper-qty-on' : ''}}">{{item.qty}}</text>
              <view class="stepper-btn stepper-btn-plus {{dayConfirmed ? 'stepper-btn-disabled' : ''}}" catchtap="incrementMeal" data-meal="{{item}}">
                <text class="stepper-btn-text">+</text>
              </view>
            </view>
          </view>
        </view>

        <!-- Horario + notas + cubiertos + guardar: cuando el día está completo -->
        <block wx:if="{{dayConfirmed}}">

          <view class="section-card">
            <text class="section-label">{{lbl_delivery_time}}</text>
            <picker mode="time" value="{{selectedTime}}" start="10:15" end="19:30" bindchange="onTimeChange">
              <view class="time-display">
                <text class="time-value">{{selectedTime}}</text>
                <view class="time-change"><text>{{lbl_tap_to_change}}</text></view>
              </view>
            </picker>
          </view>

          <view class="section-card">
            <text class="section-label">{{lbl_notes}}</text>
            <textarea class="notes-input" placeholder="{{lbl_notes_placeholder}}" placeholder-class="notes-ph" value="{{currentNotes}}" bindinput="onNotesInput" auto-height />
          </view>

          <view class="section-card" wx:if="{{isLastDay}}">
            <text class="section-label">{{lbl_cutlery_title}}</text>
            <view class="cutlery-options">
              <view class="cutlery-option {{needsCutlery ? 'cutlery-option-active' : ''}}" bindtap="setCutlery" data-value="{{true}}">
                <text class="cutlery-option-text">{{lbl_cutlery_yes}}</text>
              </view>
              <view class="cutlery-option {{!needsCutlery ? 'cutlery-option-active' : ''}}" bindtap="setCutlery" data-value="{{false}}">
                <text class="cutlery-option-text">{{lbl_cutlery_no}}</text>
              </view>
            </view>
          </view>

          <button class="btn-save-next" bindtap="saveAndNext">
            {{isLastDay ? lbl_continue : lbl_save_next}}
          </button>

        </block>

      </block>

    </view>
  </scroll-view>

</view>

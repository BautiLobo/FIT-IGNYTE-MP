/* pages/meal-select/index.wxss — elegir comidas (mismo lenguaje que tiers / plans / calendario) */

page { background:#0b0b0c; }

.container { display:flex; flex-direction:column; height:100vh; background:#0b0b0c; overflow:hidden; }

/* ── TOPBAR ── */
.topbar { background:#0b0b0c; padding:80rpx 32rpx 24rpx; border-bottom:1rpx solid #1a1a22; display:flex; align-items:center; flex-shrink:0; }
.back-btn { width:64rpx; height:64rpx; background:#1a1a22; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.back-arrow { font-size:40rpx; color:#f3f3f4; line-height:1; }
.topbar-title { flex:1; text-align:center; font-size:34rpx; font-weight:800; color:#f3f3f4; }

/* ── DAY TABS ── */
.day-tabs { display:flex; gap:10rpx; padding:18rpx 32rpx; border-bottom:1rpx solid #1a1a22; flex-shrink:0; }
.day-tab {
  flex:1; min-width:0;
  display:flex; flex-direction:column; align-items:center; gap:4rpx;
  background:#13131a; border:2rpx solid #2a2a33; border-radius:18rpx;
  padding:12rpx 0 10rpx;
  transition:background .15s, border-color .15s;
}
.day-tab-weekday { font-size:19rpx; font-weight:800; letter-spacing:1rpx; text-transform:uppercase; color:#9a9aa3; }
.day-tab-date { font-size:28rpx; font-weight:900; color:#f3f3f4; line-height:1.1; }
.day-tab-dot { width:10rpx; height:10rpx; border-radius:50%; background:transparent; margin-top:2rpx; }
.day-tab-done .day-tab-dot { background:#34D399; }

.day-tab-active { background:#e8342a; border-color:#e8342a; box-shadow:0 6rpx 20rpx rgba(232,52,42,0.4); }
.day-tab-active .day-tab-weekday { color:rgba(255,255,255,0.8); }
.day-tab-active .day-tab-date { color:#fff; }
.day-tab-active.day-tab-done .day-tab-dot { background:#fff; }

/* ── SCROLL ── */
.scroll { flex:1; min-height:0; box-sizing:border-box; overflow-x:hidden; }
.scroll-inner { padding:24rpx 32rpx; padding-bottom:calc(24rpx + env(safe-area-inset-bottom)); box-sizing:border-box; }

.loading-wrap { display:flex; justify-content:center; padding:80rpx 0; }
.spinner { width:48rpx; height:48rpx; border:4rpx solid #2a2a33; border-top-color:#e8342a; border-radius:50%; animation:spin 0.8s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }

/* ── PLAN ── */
.plan-bar {
  display:flex; align-items:center; justify-content:space-between; gap:16rpx;
  border:2rpx solid #2a2a33; border-radius:20rpx;
  padding:18rpx 22rpx; margin-bottom:24rpx;
}
.plan-bar-info { flex:1; min-width:0; display:flex; flex-direction:column; gap:4rpx; }
.plan-bar-name { font-size:30rpx; font-weight:900; font-style:italic; text-transform:uppercase; letter-spacing:-0.5rpx; line-height:1.1; }
.plan-bar-meals { font-size:20rpx; font-weight:800; letter-spacing:2rpx; text-transform:uppercase; color:#9a9aa3; }
.plan-bar-change { flex-shrink:0; background:#1a1a22; border:1rpx solid #2a2a33; border-radius:100rpx; padding:10rpx 20rpx; }
.plan-bar-change text { font-size:21rpx; font-weight:800; color:#f3f3f4; }

/* ── DÍA ACTUAL ── */
.day-head { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-bottom:18rpx; }
.day-head-title { font-size:40rpx; font-weight:900; font-style:italic; text-transform:uppercase; letter-spacing:-1rpx; color:#f3f3f4; }
.day-head-progress { display:flex; flex-direction:column; align-items:flex-end; gap:8rpx; }
.slots { display:flex; gap:6rpx; }
.slot { width:40rpx; height:8rpx; border-radius:8rpx; background:#1a1a22; }
.slot-on { background:#e8342a; }
.slot-done { background:#34D399; }
.day-head-count { font-size:20rpx; font-weight:800; letter-spacing:1.5rpx; text-transform:uppercase; color:#9a9aa3; }
.day-head-count-done { color:#34D399; }

/* ── FOTO GRANDE ── */
.photo-preview-wrap { border-radius:24rpx; overflow:hidden; height:380rpx; margin-bottom:20rpx; position:relative; border:2rpx solid #2a2a33; }
.photo-preview-img { width:100%; height:100%; }
.photo-preview-overlay { position:absolute; bottom:0; left:0; right:0; background:linear-gradient(transparent, rgba(0,0,0,0.88)); padding:28rpx 26rpx 22rpx; }
.photo-preview-name { font-size:32rpx; font-weight:900; font-style:italic; text-transform:uppercase; letter-spacing:-0.5rpx; color:#fff; display:block; }

/* ── COMIDAS ── */
.meal-list { display:flex; flex-direction:column; gap:16rpx; margin-bottom:24rpx; }

.meal-card {
  display:flex; align-items:center; gap:20rpx;
  background:#13131a; border:2rpx solid #2a2a33; border-radius:22rpx;
  padding:18rpx;
  transition:transform .12s, border-color .15s, background .15s;
}
.meal-card-hover { transform:scale(0.985); }
.meal-card-selected {
  border-color:rgba(232,52,42,0.7);
  background:linear-gradient(160deg, rgba(232,52,42,0.16) 0%, #13131a 60%);
}

.meal-thumb-wrap { position:relative; width:152rpx; height:152rpx; border-radius:18rpx; overflow:hidden; flex-shrink:0; }
.meal-thumb { width:100%; height:100%; }
.meal-thumb-placeholder { width:100%; height:100%; background:#1a1a22; display:flex; align-items:center; justify-content:center; }
.meal-thumb-label { font-size:18rpx; color:#9a9aa3; font-weight:800; letter-spacing:1rpx; }
.meal-qty-badge {
  position:absolute; top:8rpx; left:8rpx;
  min-width:36rpx; height:36rpx; padding:0 8rpx; border-radius:100rpx;
  background:#e8342a; display:flex; align-items:center; justify-content:center;
  box-shadow:0 4rpx 12rpx rgba(0,0,0,0.4);
}
.meal-qty-badge text { font-size:20rpx; font-weight:900; color:#fff; }

.meal-info { flex:1; min-width:0; display:flex; flex-direction:column; gap:10rpx; }
.meal-name { font-size:28rpx; font-weight:800; color:#f3f3f4; line-height:1.25; }
.meal-card-selected .meal-name { color:#fff; }
.macros { display:flex; flex-wrap:nowrap; gap:8rpx; }
.macro { flex:1 1 auto; text-align:center; white-space:nowrap; font-size:23rpx; font-weight:700; color:#9a9aa3; background:#1a1a22; padding:8rpx 8rpx; border-radius:10rpx; }
.macro-kcal { color:#ff6b5e; background:rgba(232,52,42,0.14); }
.macro-p { color:#34D399; background:rgba(52,211,153,0.12); }
.macro-c { color:#eab308; background:rgba(234,179,8,0.12); }
.macro-f { color:#A78BFA; background:rgba(167,139,250,0.12); }

/* stepper vertical: + arriba, cantidad, − abajo */
.meal-stepper { display:flex; flex-direction:column-reverse; align-items:center; gap:6rpx; flex-shrink:0; }
.stepper-btn { width:56rpx; height:56rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; }
.stepper-btn-minus { background:transparent; border:2rpx solid #2a2a33; box-sizing:border-box; }
.stepper-btn-plus { background:#e8342a; box-shadow:0 4rpx 14rpx rgba(232,52,42,0.4); }
.stepper-btn-disabled { opacity:0.3; box-shadow:none; }
.stepper-btn-text { font-size:34rpx; font-weight:800; color:#fff; line-height:1; margin-top:-2rpx; }
.stepper-qty { font-size:28rpx; font-weight:900; color:#5d5d65; min-width:36rpx; text-align:center; }
.stepper-qty-on { color:#f3f3f4; }

/* ── SECCIONES (horario / notas / cubiertos) ── */
.section-card { background:#13131a; border:2rpx solid #2a2a33; border-radius:22rpx; padding:22rpx 24rpx; margin-bottom:16rpx; }
.section-label { display:block; font-size:20rpx; font-weight:800; letter-spacing:3rpx; text-transform:uppercase; color:#9a9aa3; margin-bottom:14rpx; }

.time-display { display:flex; align-items:center; justify-content:space-between; }
.time-value { font-size:60rpx; font-weight:900; letter-spacing:-1rpx; color:#f3f3f4; line-height:1; }
.time-change { background:rgba(232,52,42,0.12); border:1rpx solid rgba(232,52,42,0.35); border-radius:100rpx; padding:10rpx 20rpx; }
.time-change text { font-size:21rpx; font-weight:800; color:#e8342a; }

.notes-input { background:#0b0b0c; border:1rpx solid #2a2a33; border-radius:14rpx; padding:18rpx 20rpx; font-size:26rpx; color:#f3f3f4; width:100%; min-height:80rpx; box-sizing:border-box; }
.notes-ph { color:#5d5d65; }

.cutlery-options { display:flex; gap:14rpx; }
.cutlery-option { flex:1; border:2rpx solid #2a2a33; border-radius:16rpx; padding:20rpx 10rpx; text-align:center; background:#1a1a22; }
.cutlery-option-text { font-size:24rpx; font-weight:700; color:#9a9aa3; }
.cutlery-option-active { border-color:#e8342a; background:rgba(232,52,42,0.12); }
.cutlery-option-active .cutlery-option-text { color:#fff; font-weight:800; }

/* ── BOTÓN ── */
button { margin:0 !important; padding:0 !important; }
.btn-save-next {
  background:#e8342a !important;
  border-radius:24rpx !important;
  height:96rpx;
  line-height:96rpx;
  color:#fff !important;
  font-size:32rpx !important;
  font-weight:800 !important;
  letter-spacing:1rpx;
  text-align:center;
  width:100% !important;
  margin:12rpx 0 24rpx !important;
  box-sizing:border-box;
  display:block;
  box-shadow:0 8rpx 30rpx rgba(232,52,42,0.35);
}

<view class="container">

  <view class="topbar">
    <view class="back-btn" bindtap="goBack"><text class="back-arrow">‹</text></view>
    <text class="topbar-title">{{lbl_title}}</text>
    <view style="width:64rpx;"></view>
  </view>

  <scroll-view class="scroll" scroll-y>
   <view class="scroll-inner">

    <!-- Plan -->
    <view class="plan-card">
      <text class="card-label">{{lbl_your_plan}}</text>
      <view class="plan-row">
        <view class="plan-info">
          <text class="plan-name" style="color:{{selectedPlan.color || '#f3f3f4'}};">{{selectedPlan.displayName}}</text>
          <text class="plan-sub">{{selectedPlan.meals}} {{lbl_meals_day}}</text>
        </view>
        <text class="plan-price">¥{{selectedPlan.price}}</text>
      </view>
    </view>

    <!-- Comidas -->
    <view class="card">
      <view class="card-header-row">
        <text class="card-label">{{lbl_chosen_meals}}</text>
        <view class="btn-edit" bindtap="editMeals"><text>{{lbl_edit}}</text></view>
      </view>
      <view wx:for="{{mealSummary}}" wx:key="day" class="day-block {{index === mealSummary.length - 1 ? 'day-block-last' : ''}}">
        <view class="day-header">
          <text class="day-label">{{item.dayLabel}}</text>
          <text class="day-time">{{item.time}}</text>
        </view>
        <view wx:for="{{item.meals}}" wx:key="slot" wx:for-item="meal" class="meal-row">
          <text class="meal-slot">M{{meal.slot + 1}}</text>
          <text class="meal-name">{{meal.name}}</text>
        </view>
      </view>
    </view>

    <!-- Menú completo en PDF (mismo botón que tiers) -->
    <view class="menu-btn btn-mb" hover-class="menu-btn-hover" bindtap="openBrochure">
      <view class="menu-btn-icon"><view class="doc"><view class="doc-line"></view><view class="doc-line"></view><view class="doc-line doc-line-short"></view></view></view>
      <view class="sbtn-body"><text class="sbtn-title">{{lbl_brochure}}</text></view>
      <text class="sbtn-arrow menu-btn-arrow">›</text>
    </view>

    <!-- Dirección: no se muestra en renovación (ya validada en el alta) -->
    <view class="card address-card" wx:if="{{!fromRenewal}}">
      <view class="address-info">
        <text class="card-label">{{lbl_address}}</text>
        <text class="address-text">{{order.address}}{{order.district ? ' · ' + order.district : ''}}</text>
      </view>
      <view class="btn-edit" bindtap="editAddress"><text>{{lbl_edit}}</text></view>
    </view>

    <!-- Precio -->
    <view class="card price-card">
      <view class="price-row price-row-border">
        <text class="price-label">{{lbl_plan}}</text>
        <text class="price-val {{discount > 0 ? 'price-val-strike' : ''}}">¥{{selectedPlan.price}}</text>
      </view>
      <view class="price-row price-row-border" wx:if="{{discount > 0}}">
        <text class="price-label price-green">{{lbl_discount}}</text>
        <text class="price-val price-green">-¥{{discount}}</text>
      </view>
      <view class="price-row price-row-border">
        <text class="price-label">{{lbl_delivery}}</text>
        <text class="price-val" wx:if="{{deliveryFee !== null}}">¥{{deliveryFee}}</text>
        <text class="price-val price-val-tbc" wx:else>{{lbl_delivery_tbc}}</text>
      </view>
      <view class="price-row price-row-total">
        <text class="price-total-label">{{lbl_total}}</text>
        <text class="price-total-val">¥{{total}}</text>
      </view>
    </view>

    <button class="btn-submit {{submitting ? 'btn-disabled' : ''}}" bindtap="submitOrder" disabled="{{submitting}}">
      {{submitting ? lbl_submitting : ((fromRenewal || repay) ? lbl_continue_payment : lbl_place_order)}}
    </button>
    <text class="hint">{{fromRenewal ? lbl_renewal_note : (repay ? lbl_repay_note : lbl_review_note)}}</text>

   </view>
  </scroll-view>

</view>

/* pages/order-summary/index.wxss — mismo lenguaje que tiers / plans / meal-select */

page { background:#0b0b0c; }

.container { display:flex; flex-direction:column; height:100vh; background:#0b0b0c; overflow:hidden; }

/* ── TOPBAR ── */
.topbar { background:#0b0b0c; padding:80rpx 32rpx 24rpx; border-bottom:1rpx solid #1a1a22; flex-shrink:0; display:flex; align-items:center; }
.back-btn { width:64rpx; height:64rpx; background:#1a1a22; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.back-arrow { font-size:40rpx; color:#f3f3f4; line-height:1; }
.topbar-title { flex:1; text-align:center; font-size:34rpx; font-weight:800; color:#f3f3f4; }

/* ── SCROLL ── */
.scroll { flex:1; min-height:0; box-sizing:border-box; overflow-x:hidden; }
.scroll-inner { padding:24rpx 32rpx; padding-bottom:calc(40rpx + env(safe-area-inset-bottom)); box-sizing:border-box; }

/* ── CARDS ── */
.card { background:#13131a; border:2rpx solid #2a2a33; border-radius:22rpx; padding:24rpx; margin-bottom:16rpx; }
.card-label { display:block; font-size:20rpx; font-weight:800; letter-spacing:3rpx; text-transform:uppercase; color:#9a9aa3; margin-bottom:14rpx; }
.card-header-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:10rpx; }
.card-header-row .card-label { margin-bottom:0; }

.btn-edit { flex-shrink:0; background:rgba(232,52,42,0.12); border:1rpx solid rgba(232,52,42,0.35); border-radius:100rpx; padding:8rpx 20rpx; }
.btn-edit text { font-size:21rpx; font-weight:800; color:#e8342a; }

/* ── PLAN ── */
.plan-card {
  border:2rpx solid rgba(232,52,42,0.45); border-radius:22rpx; padding:24rpx; margin-bottom:16rpx;
  background:linear-gradient(160deg, rgba(232,52,42,0.16) 0%, #13131a 60%);
}
.plan-row { display:flex; justify-content:space-between; align-items:center; gap:16rpx; }
.plan-info { flex:1; min-width:0; }
.plan-name { font-size:38rpx; font-weight:900; font-style:italic; text-transform:uppercase; letter-spacing:-1rpx; line-height:1.1; display:block; }
.plan-sub { font-size:21rpx; font-weight:800; letter-spacing:2rpx; text-transform:uppercase; color:#9a9aa3; display:block; margin-top:6rpx; }
.plan-price { flex-shrink:0; font-size:52rpx; font-weight:900; letter-spacing:-1rpx; color:#f3f3f4; }

/* ── COMIDAS ── */
.day-block { padding:14rpx 0; border-bottom:1rpx solid #1a1a22; }
.day-block-last { border-bottom:none; padding-bottom:0; }
.day-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:8rpx; }
.day-label { font-size:24rpx; font-weight:900; font-style:italic; text-transform:uppercase; letter-spacing:0.5rpx; color:#f3f3f4; }
.day-time { font-size:22rpx; font-weight:800; color:#e8342a; background:rgba(232,52,42,0.12); padding:4rpx 14rpx; border-radius:100rpx; }
.meal-row { display:flex; align-items:center; gap:12rpx; padding:6rpx 0; }
.meal-slot { flex-shrink:0; font-size:18rpx; font-weight:800; color:#9a9aa3; background:#1a1a22; border-radius:8rpx; padding:4rpx 10rpx; }
.meal-name { flex:1; min-width:0; font-size:26rpx; font-weight:600; color:#f3f3f4; line-height:1.35; }

/* ── DIRECCIÓN ── */
.address-card { display:flex; align-items:flex-start; gap:16rpx; }
.address-info { flex:1; min-width:0; }
.address-text { font-size:27rpx; font-weight:600; color:#f3f3f4; display:block; line-height:1.5; }

/* ── PRECIO ── */
.price-card { margin-bottom:24rpx; }
.price-row { display:flex; justify-content:space-between; align-items:center; padding:14rpx 0; }
.price-row-border { border-bottom:1rpx solid #1a1a22; }
.price-row-total { padding-top:20rpx; }
.price-label { font-size:26rpx; font-weight:600; color:#9a9aa3; }
.price-val { font-size:26rpx; font-weight:700; color:#f3f3f4; }
.price-green { color:#34D399 !important; }
.price-val-tbc { font-size:22rpx; font-style:italic; color:#9a9aa3; }
.price-val-strike { text-decoration:line-through; color:#5d5d65; }
.price-total-label { font-size:30rpx; font-weight:900; font-style:italic; text-transform:uppercase; color:#f3f3f4; }
.price-total-val { font-size:56rpx; font-weight:900; letter-spacing:-1rpx; color:#e8342a; text-shadow:0 6rpx 24rpx rgba(232,52,42,0.3); }

/* ── BOTONES ── */
button { margin:0 !important; padding:0 !important; background:transparent; border:none; }
.btn-submit {
  background:#e8342a !important; border-radius:24rpx !important;
  height:96rpx; line-height:96rpx; color:#fff !important; font-size:32rpx !important; font-weight:800 !important; letter-spacing:1rpx;
  text-align:center; width:100% !important; margin-bottom:16rpx !important; box-sizing:border-box; display:block;
  box-shadow:0 8rpx 30rpx rgba(232,52,42,0.35);
}
.btn-disabled { opacity:0.4; box-shadow:none; }
.hint { font-size:22rpx; font-weight:500; color:#9a9aa3; text-align:center; display:block; line-height:1.45; }

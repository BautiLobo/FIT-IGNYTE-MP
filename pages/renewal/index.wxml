<view class="container">

  <view class="topbar">
    <view class="back-btn" bindtap="goBack"><text class="back-arrow">‹</text></view>
    <text class="topbar-title">{{lbl_title}}</text>
    <view style="width:64rpx;"></view>
  </view>

  <scroll-view class="scroll" scroll-y>

    <view class="status-hero {{expired ? 'status-hero-expired' : 'status-hero-due'}}">
      <view class="status-hero-stat">
        <text class="status-hero-num {{expired ? 'status-hero-num-dash' : ''}}">{{expired ? '—' : daysLeft}}</text>
        <text class="status-hero-tag">{{expired ? lbl_expired_tag : lbl_days_left_tag}}</text>
      </view>
      <view class="status-hero-body">
        <text class="status-hero-title">{{expired ? lbl_expired : lbl_due}}</text>
        <text class="status-hero-text">{{expired ? lbl_cta_expired : lbl_cta_active}}</text>
      </view>
    </view>

    <text class="section-label">{{lbl_current_plan}}</text>

    <view class="plan-card">
      <view class="plan-card-left">
        <text class="plan-tier">{{planTier}}</text>
        <text class="plan-name">{{planName}}</text>
        <text class="plan-desc">{{planMeals}} {{lbl_meals_info}}</text>
      </view>
      <view class="plan-price-wrap">
        <text class="plan-price">¥{{currentPlanPrice}}</text>
        <text class="plan-price-sub">{{lbl_per_week}}</text>
      </view>
    </view>

    <view class="buttons">
      <view class="btn-primary" bindtap="startRenewal"><text>{{lbl_renew_btn}}</text></view>
    </view>

  </scroll-view>

  <view class="footer">
    <button class="btn-feedback" open-type="contact">{{lbl_feedback}}</button>
  </view>

</view>

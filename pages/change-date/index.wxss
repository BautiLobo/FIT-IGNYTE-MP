/* pages/change-date/index.wxss */

.container { display:flex; flex-direction:column; height:75vh; background:#0b0b0c; }

.topbar { background:#0b0b0c; padding:80rpx 28rpx 20rpx; border-bottom:1rpx solid #1a1a22; flex-shrink:0; display:flex; align-items:center; }
.back-btn { width:56rpx; height:56rpx; background:#1a1a22; border-radius:50%; display:flex; align-items:center; justify-content:center; }
.back-arrow { font-size:32rpx; color:#f3f3f4; }
.topbar-title { flex:1; text-align:center; font-size:32rpx; font-weight:800; color:#f3f3f4; }

.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 24rpx 28rpx 0;
  box-sizing: border-box;
  overflow: hidden;
}

.center-block { width:100%; display:flex; align-items:center; justify-content:center; flex:1; }

.cal-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  gap: 18rpx;
}

/* ── HEADING ── */
.heading-wrap { display:flex; flex-direction:column; gap:10rpx; text-align:center; width:100%; }
.heading { font-size:34rpx; font-weight:800; color:#f3f3f4; display:block; }
.heading-sub { font-size:24rpx; color:#beb6b6; line-height:1.5; display:block; font-weight:600; }

/* ── CURRENT-DATE PILL ── */
.counter-pill {
  align-self: center;
  background: #13131a;
  border: 1rpx solid #2a2a33;
  border-radius: 100rpx;
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #f3f3f4;
}
.counter-pill-done { background:#0a1a0a; border-color:#166534; color:#4ade80; }

/* ── CALENDAR ── */
.calendar-scroll { flex:1; min-height:0; }

.weekday-header, .week-row { display:flex; flex-direction:row; }
.weekday-header { margin-bottom: 8rpx; }

.weekday-cell {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #7a7a82;
  padding: 6rpx 0;
}

.month-label {
  display: block;
  font-size: 24rpx;
  font-weight: 800;
  color: #f3f3f4;
  margin: 14rpx 0 8rpx;
}

.week-row { gap: 6rpx; margin-bottom: 6rpx; }

.day-cell {
  flex: 1;
  aspect-ratio: 1 / 1;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

.day-cell-available { background:#13131a; color:#f3f3f4; border:1rpx solid #2a2a33; }
.day-cell-selected { background:#e8342a; color:#fff; }
.day-cell-unavailable { background:#131316; color:#3f3f45; }

/* ── LEGEND ── */
.legend { display:flex; flex-direction:row; gap:24rpx; justify-content:center; padding: 4rpx 0; flex-shrink:0; }
.legend-item { display:flex; flex-direction:row; align-items:center; gap:8rpx; }
.legend-item text { font-size:20rpx; color:#beb6b6; }
.legend-dot { width:18rpx; height:18rpx; border-radius:6rpx; }
.legend-dot-selected { background:#e8342a; }
.legend-dot-available { background:#13131a; border:1rpx solid #2a2a33; }
.legend-dot-unavailable { background:#131316; }

/* ── BUTTON ── */
button { margin:0 !important; padding:0 !important; background:transparent; border:none; }

.btn-primary {
  background: #e8342a !important;
  border-radius: 24rpx !important;
  height: 100rpx;
  line-height: 100rpx;
  color: #fff !important;
  font-size: 34rpx !important;
  font-weight: 800 !important;
  text-align: center;
  width: 100% !important;
  margin-top: 4rpx !important;
  margin-bottom: 20rpx !important;
  box-sizing: border-box;
  display: block;
  flex-shrink: 0;
}

.btn-disabled { opacity: 0.4; }

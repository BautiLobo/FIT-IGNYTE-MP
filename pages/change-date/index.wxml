<view class="container">

  <view class="topbar">
    <view class="back-btn" bindtap="goBack"><text class="back-arrow">‹</text></view>
    <text class="topbar-title">{{lbl_topbar}}</text>
    <view style="width:60rpx;"></view>
  </view>

  <view class="content">

    <view class="center-block" wx:if="{{loading}}">
      <view class="loading-wrap"><view class="spinner"></view></view>
    </view>

    <view class="cal-wrap" wx:else>

      <view class="heading-wrap">
        <text class="heading">{{lbl_heading}}</text>
        <text class="heading-sub">{{lbl_subtitle}}</text>
      </view>

      <view class="counter-pill {{canConfirm ? 'counter-pill-done' : ''}}">{{counterLabel}}</view>

      <scroll-view scroll-y class="calendar-scroll">

        <view class="weekday-header">
          <text wx:for="{{weekdayHeaders}}" wx:key="*this" class="weekday-cell">{{item}}</text>
        </view>

        <view class="month-group" wx:for="{{monthGroups}}" wx:key="key" wx:for-item="group">
          <text class="month-label">{{group.label}}</text>
          <view class="week-row" wx:for="{{group.weeks}}" wx:key="key" wx:for-item="week">
            <view
              wx:for="{{week.cells}}"
              wx:key="dateStr"
              wx:for-item="cell"
              class="day-cell day-cell-{{cell.cls}}"
              data-date="{{cell.dateStr}}"
              data-reason="{{cell.reason}}"
              bindtap="toggleDate"
            >
              <text>{{cell.dayNum}}</text>
            </view>
          </view>
        </view>

      </scroll-view>

      <view class="legend">
        <view class="legend-item">
          <view class="legend-dot legend-dot-selected"></view>
          <text>{{lbl_legend_selected}}</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot legend-dot-available"></view>
          <text>{{lbl_legend_available}}</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot legend-dot-unavailable"></view>
          <text>{{lbl_legend_unavailable}}</text>
        </view>
      </view>

      <button class="btn-primary {{!canConfirm ? 'btn-disabled' : ''}}" bindtap="confirmDates">{{lbl_confirm}}</button>

    </view>

  </view>

</view>
